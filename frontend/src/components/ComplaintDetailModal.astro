---
---

<dialog id="complaintDetailModal" class="retro-modal">
  <div class="retro-window modal-window detail-modal-window">
    <div class="retro-titlebar cyan" id="detailModalTitlebar">
      <span class="retro-title" id="detailModalTitle">🔍 TICKET_TIMELINE_INSPECTOR.SYS</span>
      <div class="retro-controls">
        <button type="button" class="modal-close-btn" id="closeDetailModalBtn">✕</button>
      </div>
    </div>

    <div class="modal-body detail-modal-body">
      <!-- Top Meta Row -->
      <div class="detail-header-row">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="retro-badge" id="detailCategoryBadge">🏢 Facilities</span>
          <span class="retro-badge" id="detailPriorityBadge">⚡ HIGH PRIORITY</span>
          <span class="retro-badge" id="detailVisibilityBadge">📢 PUBLIC BOARD</span>
        </div>
        <div class="status-stamp" id="detailStatusStamp">IN PROGRESS</div>
      </div>

      <!-- Ticket Main Title & Description -->
      <h3 class="detail-ticket-title" id="detailTicketTitle">Loading complaint title...</h3>
      <p class="detail-ticket-desc" id="detailTicketDesc">Loading description...</p>

      <!-- Visual 4-Step Progress Lifecycle -->
      <div class="lifecycle-track-box">
        <div class="track-header">
          <span>PROGRESS LIFECYCLE</span>
          <span class="text-xs text-gray-500" id="detailTicketFiledDate">Filed on: ...</span>
        </div>
        <div class="stepper-row">
          <div class="step-node active" id="stepNode1">
            <div class="node-circle">1</div>
            <span class="node-label">Submitted</span>
          </div>
          <div class="step-line" id="stepLine1"></div>
          <div class="step-node" id="stepNode2">
            <div class="node-circle">2</div>
            <span class="node-label">Under Review</span>
          </div>
          <div class="step-line" id="stepLine2"></div>
          <div class="step-node" id="stepNode3">
            <div class="node-circle">3</div>
            <span class="node-label">In Progress</span>
          </div>
          <div class="step-line" id="stepLine3"></div>
          <div class="step-node" id="stepNode4">
            <div class="node-circle">4</div>
            <span class="node-label">Resolved</span>
          </div>
        </div>
      </div>

      <!-- Official Resolution Box (shown if resolved) -->
      <div id="detailResolutionBox" class="hidden resolution-box mb-4">
        <div class="resolution-header">
          <span>🛠️ OFFICIAL PROCTOR RESOLUTION NOTE</span>
          <span id="detailResolvedDate" class="resolved-date">Date</span>
        </div>
        <p id="detailResolutionText" class="resolution-text">Resolution text goes here...</p>
      </div>

      <!-- Real-time Timeline Logs -->
      <div class="timeline-logs-box">
        <h4 class="logs-title">📋 Activity & Maintenance Log</h4>
        <div class="logs-list" id="detailTimelineList">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Student & Staff Comments Section -->
      <div class="comments-section">
        <h4 class="logs-title">💬 Community & Department Discussion</h4>
        <div class="comments-feed" id="detailCommentsFeed">
          <p class="text-xs text-gray-500 italic py-2">No discussion notes yet. Leave an update below.</p>
        </div>

        <form id="addCommentForm" class="comment-input-box mt-3">
          <input
            type="text"
            id="commentTextInput"
            class="retro-input text-xs"
            placeholder="Write a comment or follow-up note (requires login)..."
            required
          />
          <button type="submit" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-pink">
            💬 POST
          </button>
        </form>
      </div>

      <!-- Modal Footer Actions -->
      <div class="modal-actions mt-4 pt-3 border-t border-gray-200">
        <button type="button" class="retro-btn text-xs" id="shareTicketBtn">
          🔗 Copy Share Link
        </button>
        <button type="button" class="retro-btn text-xs retro-btn-yellow" id="closeDetailActionBtn">
          Close Window
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .detail-modal-window {
    max-width: 640px;
    width: 95vw;
  }
  .detail-modal-body {
    padding: 1.5rem;
    max-height: 80vh;
    overflow-y: auto;
  }
  .detail-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .detail-ticket-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--border-black);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }
  .detail-ticket-desc {
    font-size: 0.82rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .lifecycle-track-box {
    border: var(--border-width) solid var(--border-black);
    border-radius: 8px;
    padding: 1rem;
    background: #fbf7f4;
    margin-bottom: 1.25rem;
  }
  .track-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-retro);
    font-size: 0.7rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .stepper-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }
  .step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    z-index: 2;
  }
  .node-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--border-black);
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .step-node.active .node-circle {
    background: var(--pastel-mint);
    color: #064e3b;
    box-shadow: 2px 2px 0px var(--border-black);
  }
  .step-node.current .node-circle {
    background: var(--pastel-yellow);
    animation: pulseRing 1.5s infinite;
  }
  .node-label {
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .step-line {
    flex: 1;
    height: 3px;
    background: #e5e7eb;
    margin: 0 4px;
    position: relative;
    top: -9px;
  }
  .step-line.active {
    background: var(--border-black);
  }
  .timeline-logs-box, .comments-section {
    border: var(--border-width) solid var(--border-black);
    border-radius: 8px;
    padding: 0.85rem;
    background: #ffffff;
    margin-bottom: 1rem;
  }
  .logs-title {
    font-family: var(--font-retro);
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--border-black);
  }
  .logs-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .timeline-event-item {
    font-size: 0.75rem;
    padding: 0.5rem;
    background: #fbf7f4;
    border-left: 3px solid var(--pastel-pink);
    border-radius: 0 4px 4px 0;
  }
  .timeline-event-header {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }
  .comment-input-box {
    display: flex;
    gap: 0.5rem;
  }
</style>

