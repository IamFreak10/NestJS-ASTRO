---
interface Props {
  total: number;
  open: number;
  closed: number;
  high: number;
}

const { total, open, closed, high } = Astro.props;
---

<div class="stats-grid-wrapper">
  <!-- Stat 1: Total -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">TOTAL REPORTS</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-lavender)">📁</span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number">{total}</span>
      <span class="kpi-hint">All campus sectors</span>
    </div>
  </div>

  <!-- Stat 2: Active / Need Attention -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">IN TRIAGE & REPAIR</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-yellow)">⚡</span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number text-amber-700">{open}</span>
      <span class="kpi-hint">Under technician review</span>
    </div>
  </div>

  <!-- Stat 3: Resolved -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">VERIFIED RESOLVED</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-mint)">✔</span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number text-emerald-700">{closed}</span>
      <span class="kpi-hint">94.8% SLA rate</span>
    </div>
  </div>

  <!-- Stat 4: Urgent -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">HIGH & URGENT</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-rose)">🚨</span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number text-rose-700">{high}</span>
      <span class="kpi-hint">&lt; 2h dispatch target</span>
    </div>
  </div>
</div>

<style>
  .stats-grid-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .kpi-card {
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 110px;
    background: #ffffff;
    border-radius: var(--radius-lg);
  }
  .kpi-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .kpi-label {
    font-family: var(--font-retro);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #4b5563;
  }
  .kpi-icon-pill {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-black);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    box-shadow: 1px 1px 0px var(--border-black);
  }
  .kpi-value-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .kpi-number {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--border-black);
    font-feature-settings: "tnum";
  }
  .kpi-hint {
    font-size: 0.72rem;
    font-weight: 600;
    color: #6b7280;
  }
  @media (max-width: 640px) {
    .stats-grid-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
    .kpi-number {
      font-size: 1.75rem;
    }
  }
</style>
