---
import { ICONS } from '../../lib/icons.js';
---

<footer class="modern-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Mission -->
      <div class="footer-col col-brand">
        <div class="footer-brand-header">
          <img src="/images/bu-seal-circle.png" alt="Barishal University Seal" class="footer-seal-img" width="34" height="34" />
          <div>
            <h4 class="brand-title" data-i18n="footer.portalTitle">CAMPUSFIX PORTAL</h4>
            <span class="brand-sub">University of Barishal (বরিশাল বিশ্ববিদ্যালয়)</span>
          </div>
        </div>
        <p class="footer-desc" data-i18n="footer.desc">
          Official grievance and student welfare redressal system of the University of Barishal (বরিশাল বিশ্ববিদ্যালয়). Dedicated to protecting student rights, resolving facility outages, and enforcing zero-tolerance campus safety.
        </p>
        <div class="footer-badge-row">
          <span class="retro-badge" style="background: var(--pastel-mint)">
            <span set:html={ICONS.shieldCheck}></span>
            <span data-i18n="footer.antiRaggingBadge">ANTI-RAGGING CELL</span>
          </span>
          <span class="retro-badge" style="background: var(--pastel-yellow)">
            <span set:html={ICONS.zap}></span>
            <span data-i18n="footer.astroBadge">ZERO-JS ASTRO 7</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="footer-col">
        <h5 class="col-heading" data-i18n="footer.navHeading">NAVIGATION</h5>
        <ul class="col-links">
          <li>
            <a href="/">
              <span set:html={ICONS.bullhorn}></span>
              <span data-i18n="nav.publicFeed">Public Notice Feed</span>
            </a>
          </li>
          <li>
            <a href="/my-complaints">
              <span set:html={ICONS.lock}></span>
              <span data-i18n="nav.myComplaints">My Confidential Vault</span>
            </a>
          </li>
          <li>
            <a href="/track">
              <span set:html={ICONS.search}></span>
              <span data-i18n="nav.trackId">Track Ticket Status</span>
            </a>
          </li>
          <li>
            <a href="/emergency">
              <span set:html={ICONS.phoneAlert}></span>
              <span data-i18n="nav.emergency">Emergency Desk & Hotlines</span>
            </a>
          </li>
          <li>
            <a href="/architecture">
              <span set:html={ICONS.blueprint}></span>
              <span data-i18n="nav.blueprint">System Architecture & ERD</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Emergency Contacts -->
      <div class="footer-col">
        <h5 class="col-heading" data-i18n="footer.triageHeading">EMERGENCY TRIAGE</h5>
        <ul class="col-links font-mono text-xs">
          <li><strong>Proctor SOS:</strong> +880-1700-BU-HELP</li>
          <li><strong>Hall Wardens:</strong> Ext: 204 (Bangabandhu, Karnaphuli)</li>
          <li><strong>Campus Ambulance:</strong> +880-1700-BU-MEDIC</li>
          <li><strong>Bus Dispatch Desk:</strong> Ext: 305</li>
        </ul>
      </div>

      <!-- Col 4: Architecture Specs -->
      <div class="footer-col">
        <h5 class="col-heading" data-i18n="footer.specsHeading">SYSTEM SPECS</h5>
        <ul class="col-links font-mono text-xs">
          <li>• Backend: NestJS 12 + MySQL 8</li>
          <li>• ORM: Drizzle ORM Multi-Folder</li>
          <li>• Auth: Better Auth (Sliding Cookies)</li>
          <li>• Frontend: Pure Astro 7.3.8 (&lt;9 kB JS)</li>
        </ul>
        <div class="footer-quote">
          "Dedicated to resolving campus problems before your semester exams begin!"
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <p class="copyright-text" data-i18n="footer.copyright">
        © 2026 University of Barishal (বরিশাল বিশ্ববিদ্যালয়). All complaints securely moderated.
      </p>
      <div class="footer-stickers">
        <span class="cloud-badge"><span set:html={ICONS.checkCircle}></span> BU-VERIFIED</span>
        <span class="cloud-badge"><span set:html={ICONS.database}></span> AUTO-SAVED</span>
        <span class="cloud-badge"><span set:html={ICONS.sparkles}></span> 100% RETRO</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .modern-footer {
    border-top: var(--border-width) solid var(--border-black);
    background: #ffffff;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    position: relative;
    z-index: 10;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .col-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-seal-img {
    border-radius: 50%;
    border: 1px solid var(--border-black);
  }
  .brand-title {
    font-family: var(--font-retro);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .brand-sub {
    font-size: 0.72rem;
    color: #6b7280;
    font-weight: 600;
  }
  .footer-desc {
    font-size: 0.8rem;
    color: #4b5563;
    line-height: 1.6;
  }
  .footer-badge-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .col-heading {
    font-family: var(--font-retro);
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--border-black);
    letter-spacing: 0.05em;
  }
  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .col-links a {
    text-decoration: none;
    color: #4b5563;
    font-size: 0.8rem;
    font-weight: 600;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .col-links a:hover {
    color: var(--border-black);
    text-decoration: underline;
  }
  .footer-quote {
    margin-top: 1rem;
    padding: 0.6rem 0.85rem;
    background: var(--pastel-yellow);
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .footer-bottom-bar {
    border-top: 1.5px dashed #e5e7eb;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .copyright-text {
    font-size: 0.75rem;
    color: #6b7280;
  }
  .footer-stickers {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .modern-footer {
      padding-top: 2rem;
      padding-bottom: 5.5rem; /* Clearance for mobile bottom nav */
    }
    .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
