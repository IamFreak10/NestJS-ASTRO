---
import { ICONS } from '../../lib/icons.js';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<nav class="mobile-bottom-nav" aria-label="Mobile Bottom Navigation">
  <div class="bottom-nav-inner">
    <!-- 1. Public Feed -->
    <a href="/" class={`bottom-nav-item ${currentPath === '/' ? 'active' : ''}`}>
      <span class="nav-icon" set:html={ICONS.bullhorn}></span>
      <span class="nav-label" data-i18n="nav.publicFeed">Feed</span>
    </a>

    <!-- 2. My Complaints -->
    <a href="/my-complaints" class={`bottom-nav-item ${currentPath === '/my-complaints' ? 'active' : ''}`}>
      <span class="nav-icon" set:html={ICONS.vault}></span>
      <span class="nav-label" data-i18n="nav.myComplaints">Vault</span>
    </a>

    <!-- 3. Center Action: + File Complaint -->
    <button
      type="button"
      id="mobileBottomFileBtn"
      class="center-action-btn open-create-modal-trigger"
      aria-label="File a new campus complaint"
    >
      <span class="center-btn-inner">
        <span class="center-icon" set:html={ICONS.plus}></span>
      </span>
      <span class="center-label" data-i18n="nav.fileTicketBtn">FILE</span>
    </button>

    <!-- 4. Track Ticket -->
    <a href="/track" class={`bottom-nav-item ${currentPath === '/track' ? 'active' : ''}`}>
      <span class="nav-icon" set:html={ICONS.search}></span>
      <span class="nav-label" data-i18n="nav.trackId">Track</span>
    </a>

    <!-- 5. Emergency SOS -->
    <a href="/emergency" class={`bottom-nav-item ${currentPath === '/emergency' ? 'active' : ''}`}>
      <span class="nav-icon" set:html={ICONS.phoneAlert}></span>
      <span class="nav-label" data-i18n="nav.emergency">SOS</span>
    </a>
  </div>
</nav>

<style>
  .mobile-bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: #ffffff;
    border-top: var(--border-width) solid var(--border-black);
    box-shadow: 0 -3px 0px rgba(24, 24, 27, 0.08);
    padding-bottom: max(0.35rem, env(safe-area-inset-bottom));
  }

  @media (max-width: 768px) {
    .mobile-bottom-nav {
      display: block;
    }
  }

  .bottom-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 56px;
    padding: 0 0.5rem;
    position: relative;
  }

  .bottom-nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 100%;
    text-decoration: none;
    color: #4b5563;
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-sans);
    transition: all 0.12s ease;
    border-radius: var(--radius-sm);
    padding: 0.2rem 0;
    -webkit-tap-highlight-color: transparent;
  }

  .bottom-nav-item:active {
    transform: scale(0.92);
  }

  .bottom-nav-item.active {
    color: var(--border-black);
  }

  .bottom-nav-item.active .nav-icon {
    background: var(--pastel-yellow);
    border: 1.5px solid var(--border-black);
    box-shadow: 1px 1px 0px var(--border-black);
  }

  .nav-icon {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .nav-label {
    line-height: 1;
    letter-spacing: 0.02em;
  }

  /* Center Floating Action Button */
  .center-action-btn {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 0.5rem;
    margin-top: -16px;
    -webkit-tap-highlight-color: transparent;
  }

  .center-action-btn:active .center-btn-inner {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px var(--border-black);
  }

  .center-btn-inner {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pastel-pink);
    border: var(--border-width) solid var(--border-black);
    box-shadow: 2.5px 2.5px 0px var(--border-black);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .center-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--border-black);
  }

  .center-label {
    font-family: var(--font-retro);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--border-black);
    margin-top: 3px;
    letter-spacing: 0.04em;
  }
</style>
