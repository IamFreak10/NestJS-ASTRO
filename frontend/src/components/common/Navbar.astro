---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="modern-navbar">
  <div class="container navbar-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="CampusFix Home">
      <div class="brand-badge">
        <img src="/images/bu-seal-circle.png" alt="Barishal University Crest" class="brand-seal-img" width="28" height="28" />
        <div class="brand-text">
          <span class="brand-title" data-i18n="brand.title">CAMPUSFIX</span>
          <span class="brand-uni" data-i18n="brand.uni">UNIVERSITY OF BARISHAL</span>
        </div>
      </div>
      <span class="cloud-badge header-pill" data-i18n="brand.osBadge">v2.0 OS</span>
    </a>

    <!-- Desktop Navigation Pills (Hidden on mobile) -->
    <nav class="nav-pill-group desktop-nav" aria-label="Desktop Navigation">
      <a href="/" class={`nav-pill ${currentPath === '/' ? 'active' : ''}`} data-i18n="nav.publicFeed">
        📢 Public Feed
      </a>
      <a href="/my-complaints" class={`nav-pill ${currentPath === '/my-complaints' ? 'active' : ''}`} data-i18n="nav.myComplaints">
        🔒 My Grievances
      </a>
      <a href="/track" class={`nav-pill ${currentPath === '/track' ? 'active' : ''}`} data-i18n="nav.trackId">
        🔎 Track ID
      </a>
      <a href="/emergency" class={`nav-pill ${currentPath === '/emergency' ? 'active' : ''}`} data-i18n="nav.emergency">
        🚨 Emergency
      </a>
      <a href="/architecture" class={`nav-pill ${currentPath === '/architecture' ? 'active' : ''}`} data-i18n="nav.blueprint">
        🗺️ Blueprint
      </a>
    </nav>

    <!-- Header Actions (Desktop & Mobile) -->
    <div class="navbar-actions">
      <!-- Language Switcher Button (বাংলা / EN) -->
      <button
        type="button"
        id="langToggleBtn"
        class="retro-btn retro-btn-sm lang-btn"
        aria-label="Toggle language between English and Bangla"
        title="ভাষা পরিবর্তন / Switch Language (বাংলা / EN)"
      >
        🌐 <span id="langBtnLabel">বাংলা</span>
      </button>

      <!-- Universal Auth Button (Works on both desktop & mobile) -->
      <button id="openAuthModalBtn" class="retro-btn retro-btn-sm retro-btn-yellow auth-btn" aria-label="Login or View Account">
        🔑 <span id="authBtnText" data-i18n="nav.loginBtn">LOGIN</span>
      </button>

      <!-- Desktop + File Ticket Button -->
      <button id="openCreateModalBtn" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-pink desktop-only-btn open-create-modal-trigger" data-i18n="nav.fileTicketBtn">
        ✉️ + FILE TICKET
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobileMenuToggleBtn"
        class="retro-btn retro-btn-sm mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span id="menuIcon" class="menu-icon-symbol">☰</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Drawer -->
  <div id="mobileNavDrawer" class="mobile-drawer hidden">
    <div class="container drawer-container">
      <div class="drawer-header-bar">
        <span class="drawer-title">📱 BU_NAVIGATION_MENU.SYS</span>
        <span class="cloud-badge text-xs">v2.0 ACTIVE</span>
      </div>

      <nav class="drawer-nav-list" aria-label="Mobile Drawer Navigation">
        <a href="/" class={`drawer-nav-link ${currentPath === '/' ? 'active' : ''}`}>
          <span class="drawer-icon">📢</span>
          <div class="drawer-link-text">
            <strong>Public Campus Feed (উন্মুক্ত ফিড)</strong>
            <small>Browse active grievances & upvote</small>
          </div>
          <span class="drawer-arrow">→</span>
        </a>

        <a href="/my-complaints" class={`drawer-nav-link ${currentPath === '/my-complaints' ? 'active' : ''}`}>
          <span class="drawer-icon">🔒</span>
          <div class="drawer-link-text">
            <strong>My Grievances (আমার অভিযোগসমূহ)</strong>
            <small>Track personal complaints & private reports</small>
          </div>
          <span class="drawer-arrow">→</span>
        </a>

        <a href="/track" class={`drawer-nav-link ${currentPath === '/track' ? 'active' : ''}`}>
          <span class="drawer-icon">🔎</span>
          <div class="drawer-link-text">
            <strong>Track Ticket by ID (ট্র্যাক করুন)</strong>
            <small>Inspect repair logs & technician dispatches</small>
          </div>
          <span class="drawer-arrow">→</span>
        </a>

        <a href="/emergency" class={`drawer-nav-link ${currentPath === '/emergency' ? 'active' : ''}`}>
          <span class="drawer-icon">🚨</span>
          <div class="drawer-link-text">
            <strong>Emergency Desk & Hotlines (জরুরি সেবা)</strong>
            <small>24/7 Anti-Ragging & Proctor Patrol</small>
          </div>
          <span class="drawer-arrow">→</span>
        </a>

        <a href="/architecture" class={`drawer-nav-link ${currentPath === '/architecture' ? 'active' : ''}`}>
          <span class="drawer-icon">🗺️</span>
          <div class="drawer-link-text">
            <strong>System Blueprint (ব্লুপ্রিন্ট)</strong>
            <small>NestJS, MySQL & Drizzle Architecture</small>
          </div>
          <span class="drawer-arrow">→</span>
        </a>
      </nav>

      <!-- Quick Action Inside Drawer -->
      <div class="drawer-footer-actions">
        <button
          type="button"
          id="drawerCreateBtn"
          class="retro-btn retro-btn-pixel retro-btn-pink w-full open-create-modal-trigger"
        >
          ✉️ + FILE A CAMPUS COMPLAINT
        </button>

        <a href="tel:+8801700284357" class="drawer-hotline-pill">
          <span>🚨 SOS HOTLINE:</span>
          <strong>+880-1700-BU-HELP</strong>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle Logic
  const toggleBtn = document.getElementById('mobileMenuToggleBtn');
  const drawer = document.getElementById('mobileNavDrawer');
  const menuIcon = document.getElementById('menuIcon');
  const createModal = document.getElementById('createComplaintModal') as HTMLDialogElement | null;
  const drawerCreateBtn = document.getElementById('drawerCreateBtn');

  function toggleMobileMenu() {
    if (!drawer || !menuIcon || !toggleBtn) return;
    const isHidden = drawer.classList.contains('hidden');

    if (isHidden) {
      drawer.classList.remove('hidden');
      menuIcon.textContent = '✕';
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.style.backgroundColor = 'var(--pastel-rose)';
    } else {
      drawer.classList.add('hidden');
      menuIcon.textContent = '☰';
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.style.backgroundColor = '';
    }
  }

  toggleBtn?.addEventListener('click', toggleMobileMenu);

  // Close drawer when clicking modal trigger inside drawer
  drawerCreateBtn?.addEventListener('click', () => {
    drawer?.classList.add('hidden');
    if (menuIcon) menuIcon.textContent = '☰';
    toggleBtn?.setAttribute('aria-expanded', 'false');
    if (toggleBtn) toggleBtn.style.backgroundColor = '';
    createModal?.showModal();
  });

  // Close drawer if resized back to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900 && drawer && !drawer.classList.contains('hidden')) {
      drawer.classList.add('hidden');
      if (menuIcon) menuIcon.textContent = '☰';
      toggleBtn?.setAttribute('aria-expanded', 'false');
      if (toggleBtn) toggleBtn.style.backgroundColor = '';
    }
  });
</script>

<style>
  .modern-navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 248, 245, 0.98);
    backdrop-filter: blur(10px);
    border-bottom: var(--border-width) solid var(--border-black);
    padding: 0.55rem 0;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .brand-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: var(--border-width) solid var(--border-black);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neo-sm);
  }

  .brand-seal-img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: contain;
    display: block;
    border: 1px solid var(--border-black);
    background: #ffffff;
    flex-shrink: 0;
  }

  .brand-dino {
    font-size: 1.35rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-title {
    font-family: var(--font-retro);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--border-black);
  }

  .brand-uni {
    font-size: 0.65rem;
    font-weight: 800;
    color: #6b7280;
    letter-spacing: 0.05em;
  }

  .header-pill {
    background: var(--pastel-yellow);
    font-size: 0.65rem;
    font-weight: 700;
  }

  /* Desktop Nav Pills */
  .nav-pill-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #ffffff;
    border: var(--border-width) solid var(--border-black);
    padding: 0.25rem 0.35rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-neo-sm);
  }

  .nav-pill {
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--border-black);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .nav-pill:hover {
    background: var(--pastel-yellow);
  }

  .nav-pill.active {
    background: var(--pastel-lavender);
    border: 1.5px solid var(--border-black);
    box-shadow: 1px 1px 0px var(--border-black);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .mobile-menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    padding: 0;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 900;
    background: #ffffff;
  }

  .menu-icon-symbol {
    line-height: 1;
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    background: #ffffff;
    border-top: var(--border-width) solid var(--border-black);
    border-bottom: var(--border-width) solid var(--border-black);
    box-shadow: 0 6px 0px rgba(0, 0, 0, 0.06);
    animation: drawerSlide 0.18s ease-out;
  }

  .mobile-drawer.hidden {
    display: none;
  }

  @keyframes drawerSlide {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .drawer-container {
    padding: 1rem 1rem 1.25rem 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .drawer-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-retro);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--border-black);
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1.5px dashed var(--border-black);
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .drawer-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-md);
    background: #fdfaf6;
    text-decoration: none;
    color: var(--border-black);
    box-shadow: 1.5px 1.5px 0px var(--border-black);
    transition: transform 0.1s ease, background-color 0.1s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .drawer-nav-link:active {
    transform: translate(1px, 1px);
    box-shadow: 0.5px 0.5px 0px var(--border-black);
  }

  .drawer-nav-link.active {
    background: var(--pastel-yellow);
    border-width: 2px;
  }

  .drawer-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .drawer-link-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .drawer-link-text strong {
    font-size: 0.85rem;
    font-weight: 800;
  }

  .drawer-link-text small {
    font-size: 0.7rem;
    color: #6b7280;
    margin-top: 1px;
  }

  .drawer-arrow {
    font-weight: 900;
    font-size: 0.95rem;
    color: #9ca3af;
  }

  .drawer-footer-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    border-top: 1.5px solid #f1f5f9;
    padding-top: 0.85rem;
  }

  .drawer-hotline-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--pastel-rose);
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    color: #881337;
    text-decoration: none;
    font-family: var(--font-sans);
    box-shadow: 1.5px 1.5px 0px var(--border-black);
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .desktop-only-btn {
      display: none;
    }

    .header-pill {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }

    .brand-title {
      font-size: 0.82rem;
    }

    .brand-uni {
      font-size: 0.6rem;
    }

    .brand-badge {
      padding: 0.25rem 0.5rem;
    }
  }

  @media (max-width: 380px) {
    .brand-uni {
      display: none;
    }

    .brand-dino {
      font-size: 1.15rem;
    }

    .navbar-actions {
      gap: 0.35rem;
    }

    .auth-btn,
    .lang-btn {
      padding: 0.35rem 0.55rem;
      font-size: 0.72rem;
    }
  }

  .lang-btn {
    background: var(--pastel-mint);
    font-weight: 700;
    padding: 0.4rem 0.65rem;
    font-family: var(--font-bangla);
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .lang-btn:hover {
    background: var(--pastel-yellow);
  }
</style>
