---
import { ICONS } from '../../lib/icons.js';
---

<div class="marquee-wrapper">
  <div class="marquee-badge">
    <span class="live-dot"></span> LIVE TICKER
  </div>
  <div class="marquee-track">
    <div class="marquee-content">
      <span class="marquee-item"><span class="item-icon" set:html={ICONS.phoneAlert}></span> <strong>ANNOUNCEMENT:</strong> Hall Drinking Water Purifiers underwent bi-weekly chemical sanitization</span>
      <span class="separator">•</span>
      <span class="marquee-item"><span class="item-icon" set:html={ICONS.bus}></span> <strong>TRANSPORT:</strong> Campus Bus morning peak dispatch frequency increased to every 10 minutes</span>
      <span class="separator">•</span>
      <span class="marquee-item"><span class="item-icon" set:html={ICONS.shieldAlert}></span> <strong>ANTI-RAGGING CELL:</strong> 24/7 Hotline <code>+880-1700-BU-HELP</code> is actively monitored</span>
      <span class="separator">•</span>
      <span class="marquee-item"><span class="item-icon" set:html={ICONS.zap}></span> <strong>RESOLUTION ENGINE:</strong> 94.8% of reported issues resolved in under 24 hours this week</span>
      <span class="separator">•</span>
      <span class="marquee-item"><span class="item-icon" set:html={ICONS.book}></span> <strong>LIBRARY:</strong> Central Library 3rd floor Wi-Fi bandwidth doubled for Midterm Exams</span>
      <span class="separator">•</span>
      <span class="marquee-item"><span class="item-icon" set:html={ICONS.university}></span> <strong>বরিশাল বিশ্ববিদ্যালয়:</strong> সকল শিক্ষার্থী সমস্যার দ্রুত ও নির্ভরযোগ্য সমাধান নিশ্চিতকরণে আমরা প্রতিশ্রুতিবদ্ধ</span>
      <span class="separator">•</span>
    </div>
  </div>
</div>

<style>
  .marquee-wrapper {
    position: relative;
    z-index: 40;
    background: var(--pastel-yellow);
    border-bottom: var(--border-width) solid var(--border-black);
    display: flex;
    align-items: center;
    overflow: hidden;
    height: 34px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--border-black);
  }
  .marquee-badge {
    background: var(--border-black);
    color: #ffffff;
    padding: 0 0.75rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-retro);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    z-index: 2;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 50%;
    display: inline-block;
    animation: liveBlink 1.2s infinite;
  }
  .marquee-track {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    display: flex;
  }
  .marquee-content {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    animation: marqueeScroll 38s linear infinite;
    padding-left: 1rem;
  }
  .marquee-content:hover {
    animation-play-state: paused;
  }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .item-icon {
    display: inline-flex;
    align-items: center;
  }
  .separator {
    color: #9ca3af;
    font-size: 0.85rem;
  }
  @keyframes liveBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
  @keyframes marqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 640px) {
    .marquee-badge {
      font-size: 0.58rem;
      padding: 0 0.5rem;
    }
    .marquee-wrapper {
      height: 30px;
      font-size: 0.68rem;
    }
  }
</style>
