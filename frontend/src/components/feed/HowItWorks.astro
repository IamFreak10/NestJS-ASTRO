---
import { ICONS } from '../../lib/icons.js';
---

<section class="how-it-works-section">
  <div class="section-header-centered">
    <span class="retro-badge" style="background: var(--pastel-mint)">
      <span set:html={ICONS.zap}></span>
      <span data-i18n="howItWorks.badge">FAST & TRANSPARENT</span>
    </span>
    <h3 class="section-title" data-i18n="howItWorks.title">Campus Redressal Pipeline</h3>
    <p class="section-subtitle" data-i18n="howItWorks.subtitle">
      From initial submission to verified maintenance fix, every ticket follows a strict 4-step university protocol.
    </p>
  </div>

  <div class="steps-grid">
    <!-- Step 1 -->
    <div class="neo-card step-card">
      <div class="step-badge-tag">STEP 01</div>
      <div class="step-icon-wrap" style="background: var(--pastel-yellow)" set:html={ICONS.fileText}></div>
      <h4 class="step-heading" data-i18n="howItWorks.step1Title">File Complaint</h4>
      <p class="step-desc" data-i18n="howItWorks.step1Desc">
        Submit issue with location and priority. Toggle <strong>Public Wall</strong> or sealed <strong>Confidential Vault</strong> with Anonymous Protection.
      </p>
      <div class="step-footer-tag">Instant Ticket ID</div>
    </div>

    <!-- Step 2 -->
    <div class="neo-card step-card">
      <div class="step-badge-tag">STEP 02</div>
      <div class="step-icon-wrap" style="background: var(--pastel-lavender)" set:html={ICONS.shieldAlert}></div>
      <h4 class="step-heading" data-i18n="howItWorks.step2Title">Proctorial Triage</h4>
      <p class="step-desc" data-i18n="howItWorks.step2Desc">
        Proctor Office verifies ticket validity within 2 hours. Ragging, harassment, and electrical hazards trigger emergency dispatch.
      </p>
      <div class="step-footer-tag">&lt; 2h Response SLA</div>
    </div>

    <!-- Step 3 -->
    <div class="neo-card step-card">
      <div class="step-badge-tag">STEP 03</div>
      <div class="step-icon-wrap" style="background: var(--pastel-cyan)" set:html={ICONS.tool}></div>
      <h4 class="step-heading" data-i18n="howItWorks.step3Title">Technician Action</h4>
      <p class="step-desc" data-i18n="howItWorks.step3Desc">
        Campus electricians, plumbers, or transport mechanics are assigned. Real-time updates and parts orders are logged on your ticket.
      </p>
      <div class="step-footer-tag">Live Activity Log</div>
    </div>

    <!-- Step 4 -->
    <div class="neo-card step-card">
      <div class="step-badge-tag">STEP 04</div>
      <div class="step-icon-wrap" style="background: var(--pastel-mint)" set:html={ICONS.checkCircle}></div>
      <h4 class="step-heading" data-i18n="howItWorks.step4Title">Verified Fix</h4>
      <p class="step-desc" data-i18n="howItWorks.step4Desc">
        Once inspected and completed, an official written resolution note is published. The ticket gets the green RESOLVED stamp.
      </p>
      <div class="step-footer-tag">Proctor Sign-Off</div>
    </div>
  </div>
</section>

<style>
  .how-it-works-section {
    margin-bottom: 3.5rem;
  }
  .section-header-centered {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2.25rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }
  .section-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--border-black);
    letter-spacing: -0.02em;
  }
  .section-subtitle {
    font-size: 0.88rem;
    color: #4b5563;
    line-height: 1.5;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .step-card {
    padding: 1.5rem 1.25rem;
    background: #ffffff;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    gap: 0.85rem;
  }
  .step-badge-tag {
    font-family: var(--font-retro);
    font-size: 0.68rem;
    font-weight: 700;
    background: #f3f4f6;
    border: 1.5px solid var(--border-black);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    color: var(--border-black);
  }
  .step-icon-wrap {
    width: 48px;
    height: 48px;
    border: 2px solid var(--border-black);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neo-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-heading {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--border-black);
  }
  .step-desc {
    font-size: 0.78rem;
    color: #4b5563;
    line-height: 1.55;
    flex: 1;
  }
  .step-footer-tag {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    color: #6b7280;
    border-top: 1.5px dashed #e5e7eb;
    width: 100%;
    padding-top: 0.65rem;
  }

  @media (max-width: 900px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
    .section-title {
      font-size: 1.5rem;
    }
    .step-card {
      padding: 1.15rem 1rem;
    }
  }
</style>
