---
import { ICONS } from '../../lib/icons.js';

interface Props {
  total: number;
  open: number;
  closed: number;
  high: number;
}

const { total, open, closed, high } = Astro.props;
---

<div class="stats-grid-wrapper">
  <!-- Stat 1: Total -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">TOTAL REPORTS</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-lavender)" set:html={ICONS.fileText}></span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number">{total}</span>
      <span class="kpi-hint">All campus sectors</span>
    </div>
  </div>

  <!-- Stat 2: Active / Need Attention -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">IN TRIAGE & REPAIR</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-yellow)" set:html={ICONS.tool}></span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number text-amber-700">{open}</span>
      <span class="kpi-hint">Under technician review</span>
    </div>
  </div>

  <!-- Stat 3: Resolved -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">VERIFIED RESOLVED</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-mint)" set:html={ICONS.checkCircle}></span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number text-emerald-700">{closed}</span>
      <span class="kpi-hint">94.8% SLA rate</span>
    </div>
  </div>

  <!-- Stat 4: Urgent -->
  <div class="neo-card kpi-card">
    <div class="kpi-top">
      <span class="kpi-label">HIGH & URGENT</span>
      <span class="kpi-icon-pill" style="background: var(--pastel-rose)" set:html={ICONS.shieldAlert}></span>
    </div>
    <div class="kpi-value-row">
      <span class="kpi-number text-rose-700">{high}</span>
      <span class="kpi-hint">&lt; 2h dispatch target</span>
    </div>
  </div>
</div>

<style>
  .stats-grid-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .kpi-card {
    padding: 1.15rem;
    background: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.12s ease;
  }

  .kpi-card:hover {
    transform: translateY(-2px);
  }

  .kpi-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
  }

  .kpi-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #4b5563;
  }

  .kpi-icon-pill {
    width: 28px;
    height: 28px;
    border: 1.5px solid var(--border-black);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 1px 1px 0px var(--border-black);
  }

  .kpi-value-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .kpi-number {
    font-family: var(--font-retro);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
    color: var(--border-black);
  }

  .kpi-hint {
    font-size: 0.72rem;
    color: #6b7280;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .stats-grid-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .stats-grid-wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
      margin-bottom: 1.75rem;
    }

    .kpi-card {
      padding: 0.85rem;
    }

    .kpi-number {
      font-size: 1.5rem;
    }

    .kpi-label {
      font-size: 0.62rem;
    }

    .kpi-hint {
      font-size: 0.65rem;
    }
  }
</style>
