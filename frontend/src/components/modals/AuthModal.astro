---
import { ICONS } from '../../lib/icons.js';
---

<dialog id="authModal" class="retro-modal">
  <div class="retro-window modal-window">
    <div class="retro-titlebar lavender">
      <div class="flex items-center gap-2">
        <span set:html={ICONS.key}></span>
        <span class="retro-title" data-i18n="modals.authTitle">BU_STUDENT_IDENTITY.SYS</span>
      </div>
      <div class="retro-controls">
        <button type="button" class="modal-close-btn" id="closeAuthModalBtn" aria-label="Close dialog" set:html={ICONS.close}></button>
      </div>
    </div>

    <div class="modal-body">
      <!-- Auth Switcher Tabs -->
      <div class="auth-tabs" role="tablist">
        <button type="button" id="tabLoginBtn" class="auth-tab-btn active" role="tab" aria-selected="true" data-i18n="modals.tabSignIn">
          Sign In (লগইন)
        </button>
        <button type="button" id="tabRegisterBtn" class="auth-tab-btn" role="tab" aria-selected="false" data-i18n="modals.tabRegister">
          Register (নতুন একাউন্ট)
        </button>
      </div>

      <!-- Sign In Form -->
      <form id="loginForm" class="auth-form-panel">
        <div class="form-group">
          <label for="loginEmail" class="form-label" data-i18n="modals.emailLabel">University Email</label>
          <input
            type="email"
            id="loginEmail"
            name="email"
            class="retro-input"
            placeholder="student@kcku.edu"
            required
          />
        </div>

        <div class="form-group">
          <label for="loginPassword" class="form-label" data-i18n="modals.passwordLabel">Password</label>
          <input
            type="password"
            id="loginPassword"
            name="password"
            class="retro-input"
            placeholder="••••••••"
            required
          />
        </div>

        <!-- 1-Click Demo Accounts -->
        <div class="demo-login-box mb-4 p-3 bg-gray-50 border border-gray-300 rounded text-xs">
          <div class="font-bold text-gray-700 mb-1.5 flex items-center gap-1.5">
            <span set:html={ICONS.zap}></span>
            <span>Quick Demo Test Accounts (Click to Fill):</span>
          </div>
          <div class="flex gap-2 flex-wrap">
            <button type="button" class="demo-acc-btn retro-btn retro-btn-sm" data-email="student@kcku.edu" data-pass="student123">
              <span set:html={ICONS.user}></span>
              <span>Student</span>
            </button>
            <button type="button" class="demo-acc-btn retro-btn retro-btn-sm" data-email="technician@kcku.edu" data-pass="tech1234">
              <span set:html={ICONS.tool}></span>
              <span>Staff/Tech</span>
            </button>
            <button type="button" class="demo-acc-btn retro-btn retro-btn-sm" data-email="proctor@kcku.edu" data-pass="admin123">
              <span set:html={ICONS.shieldCheck}></span>
              <span>Proctor/Admin</span>
            </button>
          </div>
        </div>

        <div class="modal-actions">
          <button type="submit" class="retro-btn retro-btn-pixel retro-btn-yellow w-full inline-flex items-center justify-center gap-2" id="submitLoginBtn">
            <span set:html={ICONS.key}></span>
            <span data-i18n="modals.signInActionBtn">LOGIN TO CAMPUSFIX</span>
          </button>
        </div>
      </form>

      <!-- Register Form -->
      <form id="registerForm" class="auth-form-panel hidden">
        <!-- Student Avatar / Photo Upload Widget -->
        <div class="avatar-upload-row">
          <div class="avatar-preview-box" id="avatarPreviewBox">
            <span id="avatarPlaceholderIcon" set:html={ICONS.user}></span>
            <img id="avatarPreviewImg" class="hidden avatar-preview-img" alt="Student Photo Preview" />
          </div>
          <div class="avatar-upload-info">
            <label for="regAvatarInput" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-mint cursor-pointer inline-flex items-center gap-1.5 text-xs">
              <span set:html={ICONS.plus}></span>
              <span id="avatarUploadBtnText">Upload Student Photo</span>
            </label>
            <input
              type="file"
              id="regAvatarInput"
              accept="image/png, image/jpeg, image/webp"
              class="hidden"
            />
            <span class="text-[10px] text-gray-500 block mt-1 font-mono">Student ID photo or Avatar (Auto-compressed to ~12KB)</span>
          </div>
        </div>

        <div class="form-group">
          <label for="regName" class="form-label" data-i18n="modals.fullNameLabel">Full Name *</label>
          <input
            type="text"
            id="regName"
            name="name"
            class="retro-input"
            placeholder="e.g. Tanvir Hossain"
            required
            minlength="3"
          />
        </div>

        <div class="form-group">
          <label for="regEmail" class="form-label" data-i18n="modals.emailLabel">University Email *</label>
          <input
            type="email"
            id="regEmail"
            name="email"
            class="retro-input"
            placeholder="student@bu.ac.bd"
            required
          />
        </div>

        <div class="form-row">
          <div class="form-group half">
            <label for="regStudentId" class="form-label" data-i18n="modals.studentIdLabel">Student ID</label>
            <input
              type="text"
              id="regStudentId"
              name="studentId"
              class="retro-input"
              placeholder="e.g. BU-2023-0101"
            />
          </div>
          <div class="form-group half">
            <label for="regDept" class="form-label" data-i18n="modals.departmentLabel">Department</label>
            <input
              type="text"
              id="regDept"
              name="department"
              class="retro-input"
              placeholder="e.g. CSE / EEE / BBA"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="regPassword" class="form-label" data-i18n="modals.passwordLabel">Create Password *</label>
          <input
            type="password"
            id="regPassword"
            name="password"
            class="retro-input"
            placeholder="Minimum 6 characters"
            required
            minlength="6"
          />
        </div>

        <div class="modal-actions">
          <button type="submit" class="retro-btn retro-btn-pixel retro-btn-mint w-full inline-flex items-center justify-center gap-2" id="submitRegisterBtn">
            <span set:html={ICONS.plus}></span>
            <span data-i18n="modals.registerActionBtn">CREATE STUDENT ACCOUNT</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<script>
  const authModal = document.getElementById('authModal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('closeAuthModalBtn');
  const tabLogin = document.getElementById('tabLoginBtn');
  const tabRegister = document.getElementById('tabRegisterBtn');
  const loginForm = document.getElementById('loginForm');
  const registerForm = document.getElementById('registerForm');

  function closeModal() {
    authModal?.close();
  }

  closeBtn?.addEventListener('click', closeModal);

  // Tab switching
  tabLogin?.addEventListener('click', () => {
    tabLogin.classList.add('active');
    tabRegister?.classList.remove('active');
    loginForm?.classList.remove('hidden');
    registerForm?.classList.add('hidden');
  });

  tabRegister?.addEventListener('click', () => {
    tabRegister.classList.add('active');
    tabLogin?.classList.remove('active');
    registerForm?.classList.remove('hidden');
    loginForm?.classList.add('hidden');
  });

  // Close on outside backdrop click
  authModal?.addEventListener('click', (e) => {
    const dialogDimensions = authModal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      authModal.close();
    }
  });

  // Demo auto-fill buttons
  document.querySelectorAll('.demo-acc-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const email = btn.getAttribute('data-email');
      const pass = btn.getAttribute('data-pass');
      const emailInput = document.getElementById('loginEmail') as HTMLInputElement | null;
      const passInput = document.getElementById('loginPassword') as HTMLInputElement | null;
      if (emailInput && passInput && email && pass) {
        emailInput.value = email;
        passInput.value = pass;
      }
    });
  });
</script>

<style>
  .auth-tabs {
    display: flex;
    border-bottom: 2px solid var(--border-black);
    margin-bottom: 1.25rem;
    gap: 0.25rem;
  }
  .auth-tab-btn {
    flex: 1;
    padding: 0.65rem;
    background: #f3f4f6;
    border: none;
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
    color: #6b7280;
    transition: all 0.1s ease;
  }
  .auth-tab-btn.active {
    background: #ffffff;
    color: var(--border-black);
    border: 2px solid var(--border-black);
    border-bottom: none;
    margin-bottom: -2px;
  }
  .form-group {
    margin-bottom: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }
  .form-row .form-group {
    margin-bottom: 0;
  }
  .form-group.half {
    flex: 1;
  }
  .form-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--border-black);
  }
  .demo-login-box {
    border: 1.5px dashed var(--border-black);
    border-radius: var(--radius-sm);
    background: #faf8f5;
  }
  .demo-acc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    padding: 0.3rem 0.55rem;
  }
  .avatar-upload-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem;
    background: #f8fafc;
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-md);
    margin-bottom: 1.15rem;
  }
  .avatar-preview-box {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid var(--border-black);
    background: var(--pastel-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .avatar-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar-upload-info {
    flex: 1;
  }

  @media (max-width: 640px) {
    .form-row {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
