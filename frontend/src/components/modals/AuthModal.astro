---
---

<dialog id="authModal" class="retro-modal">
  <div class="retro-window modal-window">
    <div class="retro-titlebar lavender">
      <span class="retro-title">🔑 BU_STUDENT_IDENTITY.SYS</span>
      <div class="retro-controls">
        <button type="button" class="modal-close-btn" id="closeAuthModalBtn">✕</button>
      </div>
    </div>

    <div class="modal-body">
      <!-- Auth Switcher Tabs -->
      <div class="auth-tabs">
        <button type="button" id="tabLoginBtn" class="auth-tab-btn active">Sign In (লগইন)</button>
        <button type="button" id="tabRegisterBtn" class="auth-tab-btn">Register (নতুন একাউন্ট)</button>
      </div>

      <!-- Sign In Form -->
      <form id="loginForm" class="auth-form-panel">
        <div class="form-group">
          <label for="loginEmail" class="form-label" data-i18n="modals.emailLabel">University Email</label>
          <input
            type="email"
            id="loginEmail"
            name="email"
            class="retro-input"
            placeholder="student@kcku.edu"
            required
          />
        </div>

        <div class="form-group">
          <label for="loginPassword" class="form-label" data-i18n="modals.passwordLabel">Password</label>
          <input
            type="password"
            id="loginPassword"
            name="password"
            class="retro-input"
            placeholder="••••••••"
            required
          />
        </div>

        <!-- 1-Click Demo Accounts -->
        <div class="demo-login-box mb-4 p-3 bg-gray-50 border border-gray-300 rounded text-xs">
          <div class="font-bold text-gray-700 mb-1.5 flex items-center gap-1">
            <span>⚡</span> Quick Demo Test Accounts (Click to Fill):
          </div>
          <div class="flex gap-2 flex-wrap">
            <button type="button" class="demo-acc-btn retro-btn retro-btn-sm" data-email="student@kcku.edu" data-pass="student123">
              👤 Student
            </button>
            <button type="button" class="demo-acc-btn retro-btn retro-btn-sm" data-email="technician@kcku.edu" data-pass="tech1234">
              👷 Staff/Tech
            </button>
            <button type="button" class="demo-acc-btn retro-btn retro-btn-sm" data-email="proctor@kcku.edu" data-pass="admin123">
              👑 Proctor/Admin
            </button>
          </div>
        </div>

        <div class="modal-actions">
          <button type="submit" class="retro-btn retro-btn-pixel retro-btn-yellow w-full" id="submitLoginBtn" data-i18n="modals.signInActionBtn">
            🚀 LOGIN TO CAMPUSFIX
          </button>
        </div>
      </form>

      <!-- Register Form -->
      <form id="registerForm" class="auth-form-panel hidden">
        <!-- Student Avatar / Photo Upload Widget -->
        <div class="avatar-upload-row">
          <div class="avatar-preview-box" id="avatarPreviewBox">
            <span id="avatarPlaceholderIcon">🎓</span>
            <img id="avatarPreviewImg" class="hidden avatar-preview-img" alt="Student Photo Preview" />
          </div>
          <div class="avatar-upload-info">
            <label for="regAvatarInput" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-mint cursor-pointer inline-flex items-center gap-1.5 text-xs">
              <span>📷</span>
              <span id="avatarUploadBtnText">Upload Student Photo</span>
            </label>
            <input
              type="file"
              id="regAvatarInput"
              accept="image/png, image/jpeg, image/webp"
              class="hidden"
            />
            <span class="text-[10px] text-gray-500 block mt-1 font-mono">Student ID photo or Avatar (Auto-compressed to ~12KB)</span>
          </div>
        </div>

        <div class="form-group">
          <label for="regName" class="form-label" data-i18n="modals.fullNameLabel">Full Name</label>
          <input
            type="text"
            id="regName"
            name="name"
            class="retro-input"
            placeholder="e.g. Tanvir Ahmed"
            required
          />
        </div>

        <div class="form-group">
          <label for="regEmail" class="form-label" data-i18n="modals.emailLabel">University Email</label>
          <input
            type="email"
            id="regEmail"
            name="email"
            class="retro-input"
            placeholder="tanvir@kcku.edu"
            required
          />
        </div>

        <div class="form-row">
          <div class="form-group half">
            <label for="regStudentId" class="form-label" data-i18n="modals.studentIdLabel">Student ID</label>
            <input
              type="text"
              id="regStudentId"
              name="studentId"
              class="retro-input"
              placeholder="BU-2024-089"
            />
          </div>

          <div class="form-group half">
            <label for="regDepartment" class="form-label" data-i18n="modals.departmentLabel">Department</label>
            <input
              type="text"
              id="regDepartment"
              name="department"
              class="retro-input"
              placeholder="e.g. CSE, EEE"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="regPassword" class="form-label" data-i18n="modals.passwordLabel">Password (Min 8 chars)</label>
          <input
            type="password"
            id="regPassword"
            name="password"
            class="retro-input"
            placeholder="••••••••"
            required
            minlength="8"
          />
        </div>

        <div class="modal-actions">
          <button type="submit" class="retro-btn retro-btn-pixel retro-btn-pink w-full" id="submitRegisterBtn" data-i18n="modals.registerActionBtn">
            ✨ CREATE STUDENT ACCOUNT
          </button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<style>
  .modal-close-btn {
    background: var(--pastel-rose);
    border: 1.5px solid var(--border-black);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    font-weight: 900;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }
  .modal-window {
    max-width: 480px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }
  .avatar-upload-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.65rem 0.85rem;
    background: #fbf7f4;
    border: 1.5px dashed var(--border-black);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }
  .avatar-preview-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--border-black);
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    overflow: hidden;
    box-shadow: 2px 2px 0px var(--border-black);
    flex-shrink: 0;
  }
  .avatar-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar-upload-info {
    flex: 1;
    min-width: 0;
  }
  .modal-body {
    padding: 1.25rem;
    background: var(--card-bg);
    max-height: calc(88dvh - 44px);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
  }
  .form-group {
    margin-bottom: 1rem;
  }
  .form-row {
    display: flex;
    gap: 0.75rem;
  }
  .form-group.half {
    flex: 1;
  }
  .form-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .auth-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: var(--border-width) solid var(--border-black);
    padding-bottom: 0.5rem;
  }
  .auth-tab-btn {
    flex: 1;
    background: transparent;
    border: none;
    font-family: var(--font-retro);
    font-size: 0.75rem;
    padding: 0.65rem 0.5rem;
    cursor: pointer;
    border-radius: 6px;
    font-weight: 700;
    min-height: 42px;
    -webkit-tap-highlight-color: transparent;
  }
  .auth-tab-btn.active {
    background: var(--pastel-yellow);
    border: 1.5px solid var(--border-black);
    box-shadow: 2px 2px 0px var(--border-black);
  }
  .hidden {
    display: none !important;
  }
  .w-full {
    width: 100%;
    justify-content: center;
    padding: 0.7rem;
  }

  @media (max-width: 640px) {
    .modal-body {
      padding: 1rem 0.85rem;
    }
    .form-row {
      flex-direction: column;
      gap: 0;
    }
    .demo-acc-btn {
      flex: 1;
      min-width: 90px;
      justify-content: center;
    }
  }
</style>

