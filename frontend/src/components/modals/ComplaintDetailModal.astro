---
import { ICONS } from '../../lib/icons.js';
---

<dialog id="complaintDetailModal" class="retro-modal">
  <div class="retro-window modal-window detail-modal-window">
    <div class="retro-titlebar cyan" id="detailModalTitlebar">
      <div class="flex items-center gap-2">
        <span set:html={ICONS.search}></span>
        <span class="retro-title" id="detailModalTitle" data-i18n="modals.detailTitle">TICKET_TIMELINE_INSPECTOR.SYS</span>
      </div>
      <div class="retro-controls">
        <button type="button" class="modal-close-btn" id="closeDetailModalBtn" aria-label="Close dialog" set:html={ICONS.close}></button>
      </div>
    </div>

    <div class="modal-body detail-modal-body">
      <!-- Top Meta Row -->
      <div class="detail-header-row">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="retro-badge" id="detailCategoryBadge">Facilities</span>
          <span class="retro-badge" id="detailPriorityBadge">HIGH PRIORITY</span>
          <span class="retro-badge" id="detailVisibilityBadge">PUBLIC BOARD</span>
        </div>
        <div class="status-stamp" id="detailStatusStamp">IN PROGRESS</div>
      </div>

      <!-- Ticket Main Title & Description -->
      <h3 class="detail-ticket-title" id="detailTicketTitle">Loading complaint title...</h3>
      <p class="detail-ticket-desc" id="detailTicketDesc">Loading description...</p>

      <!-- Author Profile Info Card -->
      <div class="detail-author-card" id="detailAuthorBar">
        <div class="detail-author-avatar-wrap" id="detailAuthorAvatarWrap">
          <img id="detailAuthorAvatarImg" class="detail-author-avatar-img hidden" src="" alt="Author" />
          <span id="detailAuthorAvatarFallback" class="detail-author-avatar-fallback" set:html={ICONS.user}></span>
        </div>
        <div class="detail-author-info">
          <div class="flex items-center gap-2">
            <span class="detail-author-name" id="detailAuthorName">Loading student...</span>
            <span class="detail-author-pill" id="detailAuthorPill">COMPLAINANT</span>
          </div>
          <span class="detail-author-dept" id="detailAuthorDept">University of Barishal</span>
        </div>
      </div>

      <!-- Visual 4-Step Progress Lifecycle -->
      <div class="lifecycle-track-box">
        <div class="track-header">
          <span>PROGRESS LIFECYCLE</span>
          <span class="text-xs text-gray-500" id="detailTicketFiledDate">Filed on: ...</span>
        </div>
        <div class="stepper-row">
          <div class="step-node active" id="stepNode1">
            <div class="node-circle">1</div>
            <span class="node-label">Submitted</span>
          </div>
          <div class="step-line" id="stepLine1"></div>
          <div class="step-node" id="stepNode2">
            <div class="node-circle">2</div>
            <span class="node-label">Under Review</span>
          </div>
          <div class="step-line" id="stepLine2"></div>
          <div class="step-node" id="stepNode3">
            <div class="node-circle">3</div>
            <span class="node-label">In Progress</span>
          </div>
          <div class="step-line" id="stepLine3"></div>
          <div class="step-node" id="stepNode4">
            <div class="node-circle">4</div>
            <span class="node-label">Resolved</span>
          </div>
        </div>
      </div>

      <!-- Official Resolution Box (shown if resolved) -->
      <div id="detailResolutionBox" class="hidden resolution-box mb-4">
        <div class="resolution-header">
          <span class="flex items-center gap-1.5">
            <span set:html={ICONS.shieldCheck}></span>
            <span>OFFICIAL PROCTOR RESOLUTION NOTE</span>
          </span>
          <span id="detailResolvedDate" class="resolved-date">Date</span>
        </div>
        <p id="detailResolutionText" class="resolution-text">Resolution text goes here...</p>
      </div>

      <!-- Real-time Timeline Logs -->
      <div class="timeline-logs-box">
        <h4 class="logs-title flex items-center gap-1.5">
          <span set:html={ICONS.fileText}></span>
          <span>Activity & Maintenance Log</span>
        </h4>
        <div class="logs-list" id="detailTimelineList">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Student & Staff Comments Section -->
      <div class="comments-section">
        <h4 class="logs-title flex items-center gap-1.5" data-i18n="modals.discussionTitle">
          <span set:html={ICONS.messageSquare}></span>
          <span>Community & Department Discussion</span>
        </h4>
        <div class="comments-feed" id="detailCommentsFeed">
          <p class="text-xs text-gray-500 italic py-2">No discussion notes yet. Leave an update below.</p>
        </div>

        <form id="addCommentForm" class="comment-input-box mt-3">
          <input
            type="text"
            id="commentTextInput"
            class="retro-input text-xs"
            placeholder="Write a comment or follow-up note (requires login)..."
            data-i18n-placeholder="modals.commentPlaceholder"
            maxlength="1000"
            required
          />
          <button type="submit" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-yellow text-xs inline-flex items-center gap-1.5" id="submitCommentBtn">
            <span set:html={ICONS.send}></span>
            <span data-i18n="modals.postCommentBtn">POST</span>
          </button>
        </form>
      </div>

      <!-- Staff / Admin Triage Panel (Hidden for Students) -->
      <div id="staffTriagePanel" class="hidden triage-box mt-4 p-3 bg-amber-50 border border-amber-400 rounded-md">
        <div class="font-bold text-xs text-amber-900 mb-2 flex items-center gap-1.5">
          <span set:html={ICONS.tool}></span>
          <span>STAFF / PROCTOR TRIAGE CONTROLS</span>
        </div>
        <form id="staffResolutionForm" class="flex flex-col gap-2">
          <div class="flex items-center gap-2 flex-wrap">
            <label class="text-xs font-bold text-gray-700">Update Status:</label>
            <select id="staffStatusSelect" class="retro-input text-xs py-1 px-2">
              <option value="submitted">SUBMITTED</option>
              <option value="under_review">UNDER REVIEW</option>
              <option value="in_progress">IN PROGRESS</option>
              <option value="resolved">RESOLVED</option>
              <option value="rejected">REJECTED</option>
            </select>
          </div>

          <div class="flex flex-col gap-1 mt-1">
            <label class="text-xs font-bold text-gray-700">Official Resolution Note (Published on fix):</label>
            <textarea
              id="staffResolutionNoteInput"
              class="retro-input text-xs"
              rows="2"
              placeholder="Detail the on-ground repair actions taken, parts replaced, or proctorial findings..."
            ></textarea>
          </div>

          <div class="flex justify-end gap-2 mt-3">
            <button type="submit" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-mint text-xs inline-flex items-center gap-1.5">
              <span set:html={ICONS.check}></span>
              <span>SAVE RESOLUTION & SIGN-OFF FIX</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Modal Footer Actions -->
      <div class="modal-actions mt-4 pt-3 border-t border-gray-200">
        <button type="button" class="upvote-btn retro-btn text-xs" id="detailModalUpvoteBtn" data-id="">
          <span class="upvote-icon" set:html={ICONS.thumbsUp}></span>
          <span class="upvote-label">Me Too</span>
          <span class="upvote-count font-mono font-bold">(0)</span>
        </button>
        <button type="button" class="retro-btn text-xs inline-flex items-center gap-1" id="shareTicketBtn">
          <span set:html={ICONS.copy}></span>
          <span>Copy Share Link</span>
        </button>
        <button type="button" class="retro-btn text-xs retro-btn-yellow" id="closeDetailActionBtn" data-i18n="card.close">
          Close Window
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const detailModal = document.getElementById('complaintDetailModal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('closeDetailModalBtn');
  const closeActionBtn = document.getElementById('closeDetailActionBtn');

  function closeModal() {
    detailModal?.close();
  }

  closeBtn?.addEventListener('click', closeModal);
  closeActionBtn?.addEventListener('click', closeModal);

  // Close when clicking backdrop
  detailModal?.addEventListener('click', (e) => {
    const dialogDimensions = detailModal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      detailModal.close();
    }
  });
</script>

<style>
  .modal-close-btn {
    background: var(--pastel-rose);
    border: 1.5px solid var(--border-black);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    font-weight: 900;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }
  .detail-modal-window {
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }
  .detail-modal-body {
    padding: 1.25rem;
    max-height: calc(88dvh - 50px);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
  }
  .detail-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .detail-ticket-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--border-black);
    margin-bottom: 0.5rem;
    line-height: 1.35;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .detail-ticket-desc {
    font-size: 0.82rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .lifecycle-track-box {
    border: var(--border-width) solid var(--border-black);
    border-radius: 8px;
    padding: 1rem;
    background: #fbf7f4;
    margin-bottom: 1.25rem;
    box-sizing: border-box;
  }
  .track-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-retro);
    font-size: 0.7rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .stepper-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }
  .step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    z-index: 2;
  }
  .node-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--border-black);
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .step-node.active .node-circle {
    background: var(--pastel-mint);
    color: #064e3b;
    box-shadow: 2px 2px 0px var(--border-black);
  }
  .step-node.current .node-circle {
    background: var(--pastel-yellow);
    animation: pulseRing 1.5s infinite;
  }
  .node-label {
    font-size: 0.68rem;
    font-weight: 700;
    white-space: normal;
    text-align: center;
    line-height: 1.15;
    max-width: 75px;
    word-break: break-word;
  }
  .step-line {
    flex: 1;
    height: 3px;
    background: #e5e7eb;
    margin: 0 4px;
    margin-top: -16px;
    z-index: 1;
  }
  .step-line.active {
    background: var(--pastel-mint);
    border: 1px solid var(--border-black);
  }
  .detail-author-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: #f8fafc;
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
  }
  .detail-author-avatar-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid var(--border-black);
    overflow: hidden;
    background: var(--pastel-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .detail-author-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .detail-author-avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .detail-author-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .detail-author-name {
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--border-black);
  }
  .detail-author-pill {
    font-family: var(--font-retro);
    font-size: 0.62rem;
    background: var(--pastel-yellow);
    border: 1px solid var(--border-black);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
  .detail-author-dept {
    font-size: 0.72rem;
    color: #6b7280;
  }
  .resolution-box {
    background: #dcfce7;
    border: 2px solid #16a34a;
    border-radius: var(--radius-md);
    padding: 0.85rem;
  }
  .resolution-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: #166534;
    margin-bottom: 0.4rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed #86efac;
  }
  .resolution-text {
    font-size: 0.8rem;
    color: #14532d;
    line-height: 1.5;
  }
  .timeline-logs-box {
    margin-bottom: 1.25rem;
  }
  .logs-title {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--border-black);
    margin-bottom: 0.5rem;
  }
  .logs-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .log-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.65rem 0.75rem;
    background: #fdfaf6;
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
  }
  .log-date {
    font-size: 0.68rem;
    color: #6b7280;
    font-family: var(--font-retro);
    white-space: nowrap;
    margin-top: 1px;
  }
  .log-message {
    flex: 1;
    color: var(--border-black);
    line-height: 1.4;
  }
  .comments-section {
    margin-top: 1.25rem;
    border-top: 1.5px dashed #d1d5db;
    padding-top: 1rem;
  }
  .comments-feed {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-height: 250px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  .comment-item {
    padding: 0.65rem 0.75rem;
    background: #ffffff;
    border: 1.5px solid var(--border-black);
    border-radius: var(--radius-sm);
    box-shadow: 1.5px 1.5px 0px var(--border-black);
  }
  .comment-author-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }
  .comment-author-name {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--border-black);
  }
  .comment-time {
    font-size: 0.65rem;
    color: #9ca3af;
  }
  .comment-text {
    font-size: 0.78rem;
    color: #374151;
    line-height: 1.45;
  }
  .comment-input-box {
    display: flex;
    gap: 0.5rem;
  }
  .comment-input-box input {
    flex: 1;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @keyframes pulseRing {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  @media (max-width: 640px) {
    .detail-modal-body {
      padding: 0.85rem;
    }
    .detail-ticket-title {
      font-size: 1rem;
    }
    .modal-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .modal-actions button {
      width: 100%;
      justify-content: center;
    }
    .comment-input-box {
      flex-direction: column;
    }
  }
</style>
