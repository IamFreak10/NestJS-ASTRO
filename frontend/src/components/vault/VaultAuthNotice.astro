---
/**
 * VaultAuthNotice.astro
 * Keycard Authentication Gate for Confidential Vault Access
 */
---

<div id="unauthNotice" class="retro-window notice-card hidden">
  <div class="retro-titlebar rose">
    <span class="retro-title">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-svg">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      KEYCARD_AUTHENTICATION_REQUIRED.SYS
    </span>
    <div class="retro-controls">
      <span class="retro-ctrl-btn">_</span>
      <span class="retro-ctrl-btn">□</span>
      <span class="retro-ctrl-btn">✕</span>
    </div>
  </div>
  <div class="notice-card-body">
    <div class="notice-icon-circle amber">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-svg-lg">
        <circle cx="7.5" cy="15.5" r="5.5"></circle>
        <path d="m21 2-9.6 9.6"></path>
        <path d="m15.5 7.5 3 3L22 7l-3-3"></path>
      </svg>
    </div>

    <div class="notice-text-wrap">
      <h3 class="notice-title" data-i18n="vault.unauthTitle">Student Authentication Required</h3>
      <p class="notice-desc" data-i18n="vault.unauthDesc">
        Your personal grievance vault contains confidential submissions protected by university privacy standards. Sign in with your university account to inspect ticket progression and proctorial notes.
      </p>
    </div>

    <div class="notice-actions-wrap">
      <button onclick="document.getElementById('authModal').showModal()" class="retro-btn retro-btn-pixel retro-btn-yellow notice-cta-btn" data-i18n="vault.signInBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-svg">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        SIGN IN WITH STUDENT ID
      </button>

      <!-- 1-Click Instant Demo Login for Testing -->
      <button type="button" id="quickDemoStudentLoginBtn" class="retro-btn retro-btn-mint notice-demo-btn">
        <span>⚡</span> 1-Click Demo Login (student@kcku.edu)
      </button>

      <!-- Instant Sample Vault Preview (Offline / Guest Inspection) -->
      <button type="button" id="previewSampleVaultBtn" class="retro-btn retro-btn-cyan notice-demo-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-svg">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="7" r="3"></circle>
        </svg>
        👁️ Preview Sample Grievance Vault (Demo)
      </button>
    </div>
  </div>
</div>

<style>
  .notice-card {
    max-width: 540px;
    margin: 2.5rem auto;
    background: #ffffff;
    box-shadow: var(--shadow-neo-lg);
  }
  .notice-card-body {
    padding: 2.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }
  .notice-icon-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 2px solid var(--border-black);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-neo-sm);
  }
  .notice-icon-circle.amber {
    background: #fef3c7;
    color: #b45309;
  }
  .notice-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .notice-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--border-black);
  }
  .notice-desc {
    font-size: 0.82rem;
    color: #4b5563;
    max-width: 400px;
    line-height: 1.6;
    margin: 0 auto;
  }
  .notice-actions-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 340px;
  }
  .notice-cta-btn {
    width: 100%;
    padding: 0.75rem 1.25rem;
    justify-content: center;
    font-size: 0.82rem;
  }
  .notice-demo-btn {
    width: 100%;
    padding: 0.5rem 0.85rem;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
  }
  @media (max-width: 480px) {
    .notice-card-body {
      padding: 1.5rem 1rem;
    }
  }
</style>

