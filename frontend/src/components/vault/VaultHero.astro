---
/**
 * VaultHero.astro
 * Header Section for Student Grievance Vault & Redressal OS
 */
---

<section class="vault-hero-section">
  <div class="vault-hero-content">
    <div class="vault-eyebrow">
      <img src="/images/bu-seal-circle.png" alt="University Seal" class="vault-eyebrow-seal" width="16" height="16" />
      <span class="vault-badge-text" data-i18n="vault.eyebrow">STUDENT CONFIDENTIAL VAULT</span>
      <span class="vault-pill-dot">•</span>
      <span class="vault-pill-sub">UNIVERSITY OF BARISHAL</span>
    </div>

    <h1 class="vault-headline" data-i18n="vault.headline">
      Personal Grievance Desk. <br />
      <span class="vault-headline-highlight">Track Your Lodged Reports.</span>
    </h1>

    <p class="vault-subtext" data-i18n="vault.subtext">
      Inspect real-time technician dispatches, proctorial triage notes, and verified resolution certificates for all complaints lodged under your university credentials.
    </p>

    <!-- Slot for live dynamic stats bar -->
    <slot />
  </div>
</section>

<style>
  .vault-hero-section {
    position: relative;
    padding: 1.75rem 0 2.5rem 0;
    text-align: center;
  }
  .vault-hero-section::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(340px, 75vw);
    height: min(340px, 75vw);
    background-image: url('/images/bu-seal-circle.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.085;
    pointer-events: none;
    z-index: 0;
  }
  .vault-hero-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .vault-eyebrow-seal {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    object-fit: contain;
    display: inline-block;
  }
  .vault-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1.5px solid var(--border-black);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-neo-sm);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--border-black);
  }
  .vault-badge-text {
    font-family: var(--font-retro);
    font-size: 0.68rem;
  }
  .vault-pill-dot {
    color: #9ca3af;
  }
  .vault-pill-sub {
    color: #4b5563;
    font-weight: 800;
  }
  .vault-headline {
    font-size: 2.45rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--border-black);
  }
  .vault-headline-highlight {
    background: var(--pastel-lavender);
    padding: 0.1rem 0.65rem;
    border-radius: 6px;
    border: 2px solid var(--border-black);
    box-shadow: 2px 2px 0px var(--border-black);
    display: inline-block;
    margin-top: 0.35rem;
  }
  .vault-subtext {
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.6;
    max-width: 680px;
  }

  @media (max-width: 768px) {
    .vault-headline {
      font-size: 1.85rem;
    }
  }
</style>

