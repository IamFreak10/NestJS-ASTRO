---
import Layout from '../layouts/Layout.astro';
import { ICONS } from '../lib/icons.js';
---

<Layout title="Fullstack Engineering Blueprint & System Architecture — CampusFix | University of Barishal" currentPath="/architecture">
  <!-- Page Header -->
  <section class="page-intro-header text-center max-w-4xl mx-auto mb-8 sm:mb-10">
    <div class="inline-flex items-center gap-2 mb-3 flex-wrap justify-center">
      <span class="retro-badge inline-flex items-center gap-1.5" style="background: var(--pastel-cyan)">
        <span class="inline-flex items-center" set:html={ICONS.blueprint}></span> FULLSTACK ARCHITECTURE BLUEPRINT
      </span>
      <span class="retro-badge inline-flex items-center gap-1.5" style="background: var(--pastel-yellow)">
        <span class="inline-flex items-center" set:html={ICONS.zap}></span> ASTRO 7 VIBE CODING
      </span>
      <span class="retro-badge inline-flex items-center gap-1.5" style="background: var(--pastel-mint)">
        <span class="inline-flex items-center" set:html={ICONS.shieldCheck}></span> NESTJS 12 ENTERPRISE BACKEND
      </span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-black tracking-tight mb-3">
      How I Crafted CampusFix
    </h1>
    <p class="text-sm sm:text-base text-gray-700 leading-relaxed max-w-2xl mx-auto font-medium">
      A modern, resilient fullstack platform built with <strong>Astro 7 (Zero-JS Frontend)</strong> and <strong>NestJS 12 (Domain-Driven Backend)</strong>, backed by <strong>Drizzle ORM & MySQL 8</strong>. Here is the complete engineering journey, code design, and architectural decisions.
    </p>

    <!-- Key Metrics Ribbon -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 max-w-3xl mx-auto">
      <div class="metric-pill">
        <span class="metric-val text-emerald-600">0 KB</span>
        <span class="metric-lbl">Client Framework JS</span>
      </div>
      <div class="metric-pill">
        <span class="metric-val text-blue-600">&lt; 20ms</span>
        <span class="metric-lbl">First Contentful Paint</span>
      </div>
      <div class="metric-pill">
        <span class="metric-val text-purple-600">48 / 48</span>
        <span class="metric-lbl">Vitest Tests Passing</span>
      </div>
      <div class="metric-pill">
        <span class="metric-val text-amber-600">O(1)</span>
        <span class="metric-lbl">Pure Bangla i18n Hash</span>
      </div>
    </div>
  </section>

  <!-- Interactive Architecture Tab Switcher -->
  <div class="max-w-5xl mx-auto mb-10">
    <div class="arch-tabs-nav flex items-center justify-center gap-2 flex-wrap mb-6">
      <button type="button" class="arch-tab-btn active inline-flex items-center gap-1.5" data-target="astroSection">
        <span class="inline-flex items-center" set:html={ICONS.zap}></span>
        <span>Astro 7 Vibe Coding</span>
      </button>
      <button type="button" class="arch-tab-btn inline-flex items-center gap-1.5" data-target="nestSection">
        <span class="inline-flex items-center" set:html={ICONS.shieldCheck}></span>
        <span>NestJS 12 Backend</span>
      </button>
      <button type="button" class="arch-tab-btn inline-flex items-center gap-1.5" data-target="drizzleSection">
        <span class="inline-flex items-center" set:html={ICONS.vault}></span>
        <span>Drizzle & Schema Design</span>
      </button>
      <button type="button" class="arch-tab-btn inline-flex items-center gap-1.5" data-target="dashboardSection">
        <span class="inline-flex items-center" set:html={ICONS.radar}></span>
        <span>Live Interactive ERD</span>
      </button>
    </div>

    <!-- 1. Astro 7 Frontend Architecture Showcase -->
    <div id="astroSection" class="arch-tab-panel">
      <div class="retro-window mb-8">
        <div class="retro-titlebar yellow flex items-center justify-between">
          <span class="retro-title text-xs sm:text-sm inline-flex items-center gap-1.5">
            <span class="inline-flex items-center" set:html={ICONS.zap}></span> ASTRO_VIBE_CODING_PLAYBOOK.MD
          </span>
          <span class="cloud-badge text-xs">HTML-FIRST ARCHITECTURE</span>
        </div>

        <div class="p-6 sm:p-8 bg-white">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg border-2 border-black bg-yellow-100 flex items-center justify-center" set:html={ICONS.zap}></div>
            <div>
              <h2 class="text-xl sm:text-2xl font-extrabold text-black">
                The Astro Vibe Coding Philosophy
              </h2>
              <span class="text-xs text-gray-500 font-mono">
                Pure Speed • Modular Domains • Zero Runtime Framework Bloat
              </span>
            </div>
          </div>

          <p class="text-sm text-gray-700 leading-relaxed mb-6 font-medium">
            Instead of shipping 350KB+ of heavy React, Vue, or Angular runtime libraries to mobile student browsers over 3G campus networks, I built CampusFix using <strong>Astro 7.3.8</strong>. Every single view is pre-rendered at compilation time with 100% native Web Standards.
          </p>

          <!-- 4 Pillar Feature Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="arch-feature-card">
              <div class="feat-icon-badge" style="background: var(--pastel-yellow)" set:html={ICONS.tool}></div>
              <div>
                <h4 class="font-extrabold text-sm text-black mb-1">Domain-Driven Component Hierarchy</h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Refactored monolithic pages into clean, reusable modules: <code>components/common/</code> (Navbar, Footer, MobileNav), <code>components/feed/</code> (ComplaintCard, CategoryTabs), <code>components/vault/</code> (VaultHero, VaultStatsBar), and <code>components/modals/</code>.
                </p>
              </div>
            </div>

            <div class="arch-feature-card">
              <div class="feat-icon-badge" style="background: var(--pastel-mint)" set:html={ICONS.globe}></div>
              <div>
                <h4 class="font-extrabold text-sm text-black mb-1">Instant Pure Bangla i18n Engine</h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Built a zero-dependency translation engine using <code>O(1)</code> flat tuple dictionaries (<code>[English, Bengali]</code>). Allows users to switch the entire site to pure Bengali in &lt;0.5ms with Hind Siliguri typography and zero conjunct-breaking errors.
                </p>
              </div>
            </div>

            <div class="arch-feature-card">
              <div class="feat-icon-badge" style="background: var(--pastel-pink)" set:html={ICONS.blueprint}></div>
              <div>
                <h4 class="font-extrabold text-sm text-black mb-1">Native HTML5 Dialog Modals</h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Eliminated heavy modal libraries (Radix, HeadlessUI). Created rock-solid native <code>&lt;dialog&gt;</code> elements with standard <code>showModal()</code> and <code>close()</code> APIs, keyboard Escape dismiss, and built-in focus traps.
                </p>
              </div>
            </div>

            <div class="arch-feature-card">
              <div class="feat-icon-badge" style="background: var(--pastel-cyan)" set:html={ICONS.zap}></div>
              <div>
                <h4 class="font-extrabold text-sm text-black mb-1">Inline Stylesheets & Lazy Chunking</h4>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Configured Astro with <code>inlineStylesheets: 'always'</code> to eliminate render-blocking CSS network roundtrips. Fallback sample datasets use dynamic <code>await import()</code> so they never load unless offline.
                </p>
              </div>
            </div>
          </div>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Configured Astro with <code>inlineStylesheets: 'always'</code> to eliminate render-blocking CSS network roundtrips. Fallback sample datasets use dynamic <code>await import()</code> so they never load unless offline.
                </p>
              </div>
            </div>
          </div>

          <!-- Code Snippet Box -->
          <div class="code-showcase-box">
            <div class="code-box-header">
              <span class="code-title">frontend/src/lib/i18n.ts — High Performance Tuple Dictionary</span>
              <span class="code-lang">TypeScript</span>
            </div>
            <pre class="code-content"><code>// O(1) Instant Hash Lookup with Zero Network Overhead
const DICTIONARY: Record&lt;string, [string, string]&gt; = &#123;
  'nav.publicFeed': ['Public Feed', 'উন্মুক্ত ফিড'],
  'nav.myComplaints': ['My Grievances', 'আমার অভিযোগসমূহ'],
  'hero.headline': [
    'Resolve Campus Problems. &lt;br /&gt;&lt;span&gt;Empower Student Voices.&lt;/span&gt;',
    'ক্যাম্পাসের সমস্যা সমাধান হোক দ্রুত। &lt;br /&gt;&lt;span&gt;শিক্ষার্থীদের কণ্ঠস্বর হোক শক্তিশালী।&lt;/span&gt;',
  ],
  'status.resolved': ['RESOLVED', 'সমাধানকৃত'],
  'card.upvoteBtn': ['+1 Me Too', '+১ আমিও ভুক্তভোগী'],
&#125;;

export function resolveTranslation(lang: 'en' | 'bn', key: string): string &#123;
  return DICTIONARY[key]?.[lang === 'bn' ? 1 : 0] || key;
&#125;</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. NestJS 12 Backend Architecture Showcase -->
    <div id="nestSection" class="arch-tab-panel hidden">
      <div class="retro-window mb-8">
        <div class="retro-titlebar rose flex items-center justify-between">
          <span class="retro-title text-xs sm:text-sm inline-flex items-center gap-1.5">
            <span class="inline-flex items-center" set:html={ICONS.shieldCheck}></span> NESTJS_ENTERPRISE_ARCHITECTURE.MD
          </span>
          <span class="cloud-badge text-xs">MODULAR DOMAIN DESIGN</span>
        </div>

        <div class="p-6 sm:p-8 bg-white">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg border-2 border-black bg-rose-100 flex items-center justify-center" set:html={ICONS.shieldCheck}></div>
            <div>
              <h2 class="text-xl sm:text-2xl font-extrabold text-black">
                NestJS 12 Domain-Driven Backend
              </h2>
              <span class="text-xs text-gray-500 font-mono">
                Clean Separation of Concerns • Better Auth • Cryptographic Privacy
              </span>
            </div>
          </div>

          <p class="text-sm text-gray-700 leading-relaxed mb-6 font-medium">
            The backend is architected in NestJS 12 following strict Domain-Driven Design (DDD) principles. Every module is isolated, testable, and encapsulates its own controller, service, DTO validations, and security guards.
          </p>

          <!-- Modules Breakdown Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="module-card">
              <div class="mod-icon w-8 h-8 mb-2 flex items-center justify-center" set:html={ICONS.lock}></div>
              <h4 class="font-extrabold text-sm mb-1">AuthModule</h4>
              <p class="text-xs text-gray-600 leading-relaxed">
                Better Auth integration with Scrypt password hashing, sliding session cookies, and RBAC guards (Admin, Staff, Student).
              </p>
            </div>

            <div class="module-card">
              <div class="mod-icon w-8 h-8 mb-2 flex items-center justify-center" set:html={ICONS.fileText}></div>
              <h4 class="font-extrabold text-sm mb-1">ComplaintsModule</h4>
              <p class="text-xs text-gray-600 leading-relaxed">
                Public notice board queries, confidential vault isolation, category filtering, and atomic upvoting transactions.
              </p>
            </div>

            <div class="module-card">
              <div class="mod-icon w-8 h-8 mb-2 flex items-center justify-center" set:html={ICONS.tool}></div>
              <h4 class="font-extrabold text-sm mb-1">TicketsModule</h4>
              <p class="text-xs text-gray-600 leading-relaxed">
                Maintenance technician lifecycle management, dispatch logs, resolution verification, and timeline generation.
              </p>
            </div>

            <div class="module-card">
              <div class="mod-icon w-8 h-8 mb-2 flex items-center justify-center" set:html={ICONS.vault}></div>
              <h4 class="font-extrabold text-sm mb-1">DatabaseModule</h4>
              <p class="text-xs text-gray-600 leading-relaxed">
                Multi-folder Drizzle ORM client provider connected to MySQL 8 with connection pooling and automated migrations.
              </p>
            </div>
          </div>

          <!-- Deep Feature: The Privacy Gate & Atomic Upvoting -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
            <div class="p-5 border-2 border-black rounded-xl bg-orange-50/50 shadow-neo-sm">
              <h4 class="font-extrabold text-sm text-black mb-2 flex items-center gap-2">
                <span class="inline-flex items-center" set:html={ICONS.userMask}></span> Strict Privacy Gate for Whistleblowers
              </h4>
              <p class="text-xs text-gray-700 leading-relaxed font-medium">
                When a student submits with <code>isAnonymous: true</code>, the service transforms the record before dispatching to the public feed. Identifiers like <code>studentId</code> and <code>email</code> are stripped into <code>Anonymous Student</code>, while internally maintaining cryptographic ownership for administrative safety.
              </p>
            </div>

            <div class="p-5 border-2 border-black rounded-xl bg-emerald-50/50 shadow-neo-sm">
              <h4 class="font-extrabold text-sm text-black mb-2 flex items-center gap-2">
                <span class="inline-flex items-center" set:html={ICONS.thumbsUp}></span> Atomic Upvoting & Concurrency Safety
              </h4>
              <p class="text-xs text-gray-700 leading-relaxed font-medium">
                The <code>complaint_upvotes</code> table enforces a compound unique key constraint on <code>(complaintId, userId)</code>. Upvoting executes inside an atomic database transaction that toggles vote records and safely updates counters without race conditions.
              </p>
            </div>
          </div>

          <!-- Code Snippet Box -->
          <div class="code-showcase-box">
            <div class="code-box-header">
              <span class="code-title">backend/src/complaints/complaints.service.ts — Privacy Gate Logic</span>
              <span class="code-lang">TypeScript</span>
            </div>
            <pre class="code-content"><code>// Redact author details on public responses if isAnonymous is active
export function sanitizePublicComplaint(c: ComplaintWithAuthor) &#123;
  if (!c.isAnonymous) return c;
  return &#123;
    ...c,
    author: &#123;
      name: 'Anonymous Student',
      department: c.author?.department || 'Student Body',
      studentId: null, // Redacted
      email: null,     // Redacted
    &#125;,
  &#125;;
&#125;</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Drizzle ORM & Schema Design Showcase -->
    <div id="drizzleSection" class="arch-tab-panel hidden">
      <div class="retro-window mb-8">
        <div class="retro-titlebar mint flex items-center justify-between">
          <span class="retro-title text-xs sm:text-sm inline-flex items-center gap-1.5">
            <span class="inline-flex items-center" set:html={ICONS.vault}></span> DRIZZLE_MULTI_FOLDER_SCHEMA.MD
          </span>
          <span class="cloud-badge text-xs">MYSQL 8 RELATIONAL MODEL</span>
        </div>

        <div class="p-6 sm:p-8 bg-white">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg border-2 border-black bg-emerald-100 flex items-center justify-center" set:html={ICONS.vault}></div>
            <div>
              <h2 class="text-xl sm:text-2xl font-extrabold text-black">
                Drizzle ORM Multi-Folder Architecture
              </h2>
              <span class="text-xs text-gray-500 font-mono">
                Multi-Folder Modularity • Strict Types • Zero Prisma Engine Bloat
              </span>
            </div>
          </div>

          <p class="text-sm text-gray-700 leading-relaxed mb-6 font-medium">
            To avoid monolithic schema files that become impossible to maintain, database tables are structured across modular subfolders in <code>backend/src/database/schema/</code>:
          </p>

          <!-- 4 Schema Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="schema-table-card">
              <div class="table-header-pill">TABLE: `users` & `sessions`</div>
              <ul class="table-field-list">
                <li><code>id</code>: varchar(36) PRIMARY KEY</li>
                <li><code>role</code>: enum('student', 'staff', 'admin')</li>
                <li><code>student_id</code>: varchar(32) UNIQUE (e.g. BU-2024-089)</li>
                <li><code>department</code>: varchar(128)</li>
              </ul>
            </div>

            <div class="schema-table-card">
              <div class="table-header-pill">TABLE: `complaints`</div>
              <ul class="table-field-list">
                <li><code>id</code>: int AUTO_INCREMENT PRIMARY KEY</li>
                <li><code>category</code>: enum('facilities', 'hostel_canteen', ...)</li>
                <li><code>visibility</code>: enum('public', 'private')</li>
                <li><code>is_anonymous</code>: boolean DEFAULT false</li>
                <li><code>status</code>: enum('submitted', 'in_progress', 'resolved')</li>
              </ul>
            </div>

            <div class="schema-table-card">
              <div class="table-header-pill">TABLE: `complaint_upvotes`</div>
              <ul class="table-field-list">
                <li><code>id</code>: int AUTO_INCREMENT PRIMARY KEY</li>
                <li><code>complaint_id</code>: int REFERENCES complaints(id)</li>
                <li><code>user_id</code>: varchar(36) REFERENCES users(id)</li>
                <li><strong>UNIQUE KEY:</strong> `(complaint_id, user_id)`</li>
              </ul>
            </div>

            <div class="schema-table-card">
              <div class="table-header-pill">TABLE: `tickets` & `timelines`</div>
              <ul class="table-field-list">
                <li><code>id</code>: int AUTO_INCREMENT PRIMARY KEY</li>
                <li><code>complaint_id</code>: int (Linked grievance)</li>
                <li><code>assigned_tech_id</code>: varchar(36)</li>
                <li><code>resolution_note</code>: text (Verified repair logs)</li>
              </ul>
            </div>
          </div>

          <!-- Production Deployment Note -->
          <div class="p-5 border-2 border-black rounded-xl bg-yellow-50/70 shadow-neo-sm">
            <h4 class="font-extrabold text-sm text-black mb-1 flex items-center gap-2">
              <span class="inline-flex items-center" set:html={ICONS.zap}></span> 1-Command Production Deployment Pipeline
            </h4>
            <p class="text-xs text-gray-700 leading-relaxed font-medium">
              We configured <code>npm run zip:all</code> which builds the NestJS backend into <code>backend-deploy.zip</code> (complete with cPanel Passenger <code>app.js</code> entrypoint and production lockfiles) and compiles Astro static assets into <code>frontend-dist.zip</code> in under 3 seconds!
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Interactive Live Architecture Dashboard (Iframe) -->
    <div id="dashboardSection" class="arch-tab-panel hidden">
      <div class="retro-window mb-8">
        <div class="retro-titlebar cyan flex items-center justify-between">
          <span class="retro-title text-xs sm:text-sm inline-flex items-center gap-1.5">
            <span class="inline-flex items-center" set:html={ICONS.radar}></span> INTERACTIVE_ARCHITECTURE_DASHBOARD.HTML
          </span>
          <a
            href="/ARCHITECTURE_DASHBOARD.html"
            target="_blank"
            class="text-xs font-bold underline text-black hover:text-purple-700 bg-white px-2 py-0.5 rounded border border-black"
          >
            [↗ Open Fullscreen]
          </a>
        </div>
        <div class="bg-white p-2 sm:p-3">
          <iframe
            src="/ARCHITECTURE_DASHBOARD.html"
            class="w-full h-[520px] sm:h-[680px] border-none rounded-lg"
            title="Interactive System Architecture Dashboard"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Metric Pill */
  .metric-pill {
    background: #ffffff;
    border: 2px solid var(--border-black);
    padding: 0.75rem 0.5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-neo-sm);
    text-align: center;
    transition: transform 0.1s ease;
  }
  .metric-pill:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-neo);
  }
  .metric-val {
    display: block;
    font-size: 1.15rem;
    font-weight: 800;
    font-family: monospace;
    line-height: 1.2;
  }
  .metric-lbl {
    font-size: 0.68rem;
    color: #4b5563;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Architecture Tabs */
  .arch-tab-btn {
    background: #ffffff;
    border: 2px solid var(--border-black);
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: var(--shadow-neo-sm);
    transition: all 0.12s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .arch-tab-btn:hover {
    background: var(--pastel-yellow);
    transform: translateY(-2px);
    box-shadow: var(--shadow-neo);
  }
  .arch-tab-btn.active {
    background: var(--border-black);
    color: #ffffff;
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--border-black);
  }

  /* Feature Card */
  .arch-feature-card {
    background: #fbf8f5;
    border: 2px solid var(--border-black);
    border-radius: var(--radius-md);
    padding: 1.1rem;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    box-shadow: var(--shadow-neo-sm);
    transition: transform 0.12s ease;
  }
  .arch-feature-card:hover {
    transform: translateY(-2px);
    background: #ffffff;
    box-shadow: var(--shadow-neo);
  }
  .feat-icon-badge {
    width: 38px;
    height: 38px;
    border: 2px solid var(--border-black);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
    box-shadow: 1px 1px 0 var(--border-black);
  }

  /* Module Card */
  .module-card {
    background: #ffffff;
    border: 2px solid var(--border-black);
    border-radius: var(--radius-md);
    padding: 1.1rem;
    box-shadow: var(--shadow-neo-sm);
    transition: transform 0.12s ease;
  }
  .module-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-neo);
    background: var(--pastel-yellow);
  }
  .mod-icon {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
  }

  /* Schema Table Card */
  .schema-table-card {
    background: #ffffff;
    border: 2px solid var(--border-black);
    border-radius: var(--radius-md);
    padding: 1rem;
    box-shadow: var(--shadow-neo-sm);
  }
  .table-header-pill {
    background: var(--pastel-cyan);
    border: 1.5px solid var(--border-black);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-family: monospace;
    font-weight: 800;
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
    display: inline-block;
  }
  .table-field-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.72rem;
    color: #4b5563;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .table-field-list code {
    background: #f3f4f6;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: #111827;
    font-weight: 600;
  }

  /* Code Showcase Box */
  .code-showcase-box {
    border: 2px solid var(--border-black);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-neo-sm);
    background: #18181b;
  }
  .code-box-header {
    background: #27272a;
    padding: 0.5rem 1rem;
    border-bottom: 2px solid var(--border-black);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: monospace;
    font-size: 0.75rem;
    color: #d4d4d8;
  }
  .code-lang {
    background: var(--pastel-yellow);
    color: #000000;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.65rem;
  }
  .code-content {
    margin: 0;
    padding: 1rem;
    color: #a7f3d0;
    font-family: monospace;
    font-size: 0.78rem;
    overflow-x: auto;
    line-height: 1.5;
  }
</style>

<script>
  // Tab Switcher Controller
  const tabBtns = document.querySelectorAll('.arch-tab-btn');
  const tabPanels = document.querySelectorAll('.arch-tab-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;

      tabBtns.forEach((b) => b.classList.remove('active'));
      tabPanels.forEach((p) => p.classList.add('hidden'));

      btn.classList.add('active');
      document.getElementById(targetId)?.classList.remove('hidden');
    });
  });
</script>
