---
import Layout from '../layouts/Layout.astro';
import StatsGrid from '../components/feed/StatsGrid.astro';
import CategoryTabs from '../components/feed/CategoryTabs.astro';
import ComplaintCard from '../components/feed/ComplaintCard.astro';
import HowItWorks from '../components/feed/HowItWorks.astro';
import FAQSection from '../components/feed/FAQSection.astro';
import { SAMPLE_COMPLAINTS } from '../services/sampleData.js';
import { ICONS } from '../lib/icons.js';
import type { Complaint, ComplaintCategory } from '../types/complaint.js';

const rawApiUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api').trim().replace(/\/$/, '');
const API_URL = rawApiUrl.endsWith('/api') ? rawApiUrl : `${rawApiUrl}/api`;

// Read query params from URL
const url = new URL(Astro.request.url);
const selectedCategory = (url.searchParams.get('category') || 'all') as ComplaintCategory | 'all';
const searchQuery = (url.searchParams.get('search') || '').toLowerCase().trim();

let complaints: Complaint[] = [];
let isLiveFromApi = false;

try {
  const query = new URLSearchParams();
  if (selectedCategory && selectedCategory !== 'all') {
    query.append('category', selectedCategory);
  }
  if (searchQuery) {
    query.append('search', searchQuery);
  }

  const endpoint = `${API_URL}/complaints/public${query.toString() ? `?${query.toString()}` : ''}`;
  const res = await fetch(endpoint);
  if (res.ok) {
    const json = await res.json();
    if (json.data?.items && json.data.items.length > 0) {
      complaints = json.data.items;
      isLiveFromApi = true;
    }
  }
} catch {
  // Gracefully fallback
}

// Fallback to sample data if database has no records yet
if (complaints.length === 0) {
  complaints = SAMPLE_COMPLAINTS.filter((c) => {
    const matchesCat = selectedCategory === 'all' || c.category === selectedCategory;
    const matchesSearch =
      !searchQuery ||
      c.title.toLowerCase().includes(searchQuery) ||
      c.description.toLowerCase().includes(searchQuery);
    return matchesCat && matchesSearch;
  });
}

const stats = {
  total: 6,
  open: 3,
  closed: 2,
  high: 3,
};
---

<Layout title="CampusFix — Student Welfare & Public Grievance Feed | University of Barishal" currentPath="/">
  <!-- Modern Hero Section -->
  <section class="modern-hero-section">
    <div class="hero-content">
      <!-- Eyebrow Badge -->
      <div class="hero-eyebrow">
        <span class="pulse-indicator"></span>
        <span class="eyebrow-text" data-i18n="hero.engineStatus">RESOLUTION ENGINE ONLINE</span>
        <span class="eyebrow-divider">•</span>
        <span class="eyebrow-sub" data-i18n="hero.subOfficial">UNIVERSITY OF BARISHAL OFFICIAL STUDENT WELFARE</span>
        {isLiveFromApi ? (
          <span class="retro-badge" style="background: var(--pastel-mint)">LIVE DB</span>
        ) : (
          <span class="retro-badge" style="background: var(--pastel-cyan)">DEMO DATA</span>
        )}
      </div>

      <!-- Main Headline -->
      <h1 class="hero-headline" data-i18n="hero.headline">
        Resolve Campus Problems. <br />
        <span class="headline-highlight">Empower Student Voices.</span>
      </h1>

      <!-- Description -->
      <p class="hero-subtext" data-i18n="hero.description">
        The official real-time complaint and grievance redressal system of the <strong>University of Barishal (বরিশাল বিশ্ববিদ্যালয়)</strong>. File classroom maintenance, hostel mess hygiene, campus bus delays, or confidential anti-ragging reports with cryptographic anonymity.
      </p>

      <!-- Action Button Group -->
      <div class="hero-action-row">
        <button class="retro-btn retro-btn-pixel retro-btn-pink hero-btn-lg open-create-modal-trigger inline-flex items-center justify-center gap-2">
          <span class="inline-flex items-center" set:html={ICONS.plus}></span>
          <span data-i18n="hero.fileBtn">FILE A COMPLAINT</span>
        </button>
        <a href="/track" class="retro-btn retro-btn-pixel retro-btn-yellow hero-btn-lg inline-flex items-center justify-center gap-2">
          <span class="inline-flex items-center" set:html={ICONS.search}></span>
          <span data-i18n="hero.trackBtn">TRACK TICKET BY ID</span>
        </a>
        <a href="/emergency" class="retro-btn hero-btn-lg emergency-hero-btn inline-flex items-center justify-center gap-2" style="background: var(--pastel-rose); color: #881337">
          <span class="inline-flex items-center" set:html={ICONS.phoneAlert}></span>
          <span data-i18n="hero.emergencyBtn">Emergency Hotlines</span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="hero-trust-bar">
        <span class="trust-pill inline-flex items-center gap-1.5"><span class="inline-flex items-center" set:html={ICONS.zap}></span> &lt; 2h Triage Response</span>
        <span class="trust-pill inline-flex items-center gap-1.5"><span class="inline-flex items-center" set:html={ICONS.userMask}></span> 100% Anonymous Option</span>
        <span class="trust-pill inline-flex items-center gap-1.5"><span class="inline-flex items-center" set:html={ICONS.shieldAlert}></span> Zero-Tolerance Ragging</span>
        <span class="trust-pill inline-flex items-center gap-1.5"><span class="inline-flex items-center" set:html={ICONS.shieldCheck}></span> Verified Technician Sign-off</span>
      </div>
    </div>
  </section>

  <!-- Real-time Stats Grid -->
  <StatsGrid
    total={stats.total}
    open={stats.open}
    closed={stats.closed}
    high={stats.high}
  />

  <!-- 4-Step How It Works Section -->
  <HowItWorks />

  <!-- Department Filter Toolbar & Search -->
  <CategoryTabs activeCategory={selectedCategory} />

  <!-- Active Complaints Feed -->
  <section class="complaints-feed-section">
    <div class="feed-section-header">
      <div class="header-left">
        <h3 class="feed-title inline-flex items-center gap-2">
          <span class="inline-flex items-center text-black" set:html={ICONS.bullhorn}></span>
          Active Campus Reports
        </h3>
        <span class="cloud-badge feed-count-pill">{complaints.length} ISSUES FOUND</span>
      </div>
      <div class="header-right text-xs text-gray-500 font-medium">
        Sorted by <strong>Upvotes & Recency</strong> • Click <strong>Timeline</strong> to view repair log
      </div>
    </div>

    {complaints.length === 0 ? (
      <div class="neo-card empty-state-box">
        <div class="empty-icon inline-flex items-center justify-center w-12 h-12 rounded-full border-2 border-black bg-yellow-100 mx-auto mb-3" set:html={ICONS.search}></div>
        <h4 class="font-extrabold text-base mb-1">No complaints found in this category!</h4>
        <p class="text-xs text-gray-500 max-w-sm mx-auto mb-4">
          Everything in this department seems to be running smoothly. Facing a maintenance issue?
        </p>
        <button onclick="document.getElementById('createComplaintModal').showModal()" class="retro-btn retro-btn-pixel retro-btn-pink inline-flex items-center gap-2 mx-auto">
          <span class="inline-flex items-center" set:html={ICONS.plus}></span> FILE FIRST COMPLAINT
        </button>
      </div>
    ) : (
      <div class="modern-complaints-grid">
        {complaints.map((item) => (
          <ComplaintCard complaint={item} />
        ))}
      </div>
    )}
  </section>

  <!-- Student Welfare FAQ Accordion -->
  <FAQSection />
</Layout>

<style>
  .modern-hero-section {
    padding: 2.5rem 0 3.5rem 0;
    text-align: center;
  }
  .hero-content {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1.5px solid var(--border-black);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-neo-sm);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .pulse-indicator {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulseGlow 1.5s infinite;
  }
  .eyebrow-divider {
    color: #9ca3af;
  }
  .eyebrow-sub {
    color: #4b5563;
  }
  .hero-headline {
    font-size: 2.85rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--border-black);
  }
  .headline-highlight {
    background: var(--pastel-yellow);
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
    border: 2px solid var(--border-black);
    box-shadow: 2px 2px 0px var(--border-black);
    display: inline-block;
    margin-top: 0.35rem;
  }
  .hero-subtext {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.6;
    max-width: 720px;
  }
  .hero-action-row {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .hero-btn-lg {
    padding: 0.75rem 1.45rem;
    font-size: 0.9rem;
  }
  .hero-trust-bar {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }
  .trust-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: #4b5563;
    background: #ffffff;
    border: 1px solid #d1d5db;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }
  .complaints-feed-section {
    margin-bottom: 4rem;
  }
  .feed-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-black);
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .feed-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--border-black);
  }
  .feed-count-pill {
    background: var(--pastel-lavender);
    font-size: 0.68rem;
  }
  .modern-complaints-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }
  .empty-state-box {
    text-align: center;
    padding: 3rem 1.5rem;
    background: #ffffff;
  }
  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  @media (max-width: 768px) {
    .modern-hero-section {
      padding: 1.5rem 0 2rem 0;
    }
    .hero-headline {
      font-size: 2.1rem;
    }
    .modern-complaints-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .feed-section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  @media (max-width: 540px) {
    .hero-headline {
      font-size: 1.75rem;
    }
    .hero-subtext {
      font-size: 0.88rem;
    }
    .hero-action-row {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .hero-btn-lg {
      width: 100%;
      text-align: center;
    }
    .hero-eyebrow {
      font-size: 0.65rem;
      padding: 0.25rem 0.6rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .eyebrow-divider, .eyebrow-sub {
      display: none;
    }
  }
</style>
