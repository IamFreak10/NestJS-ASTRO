---
import Layout from '../layouts/Layout.astro';
import { ICONS } from '../lib/icons.js';
---

<Layout title="Track Campus Complaint by ID — CampusFix | University of Barishal" currentPath="/track">
  <!-- Page Header -->
  <section class="page-intro-header text-center max-w-3xl mx-auto mb-6 sm:mb-8">
    <div class="inline-flex items-center gap-2 mb-2">
      <span class="retro-badge inline-flex items-center gap-1.5" style="background: var(--pastel-yellow)" data-i18n="track.badge">
        <span class="inline-flex items-center" set:html={ICONS.radar}></span> INSTANT TICKET RADAR
      </span>
      <span class="cloud-badge text-xs">BU REAL-TIME SCAN</span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-black tracking-tight mb-2" data-i18n="track.title">
      Track Complaint Progress
    </h1>
    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed px-2 max-w-2xl mx-auto" data-i18n="track.subtitle">
      Enter any complaint ticket number (or click a test ticket below) to inspect real-time maintenance dispatches, proctorial triage notes, and verified resolution sign-offs.
    </p>
  </section>

  <!-- Search Input Console Window -->
  <div class="retro-window max-w-3xl mx-auto mb-8 track-radar-window">
    <div class="retro-titlebar yellow flex items-center justify-between">
      <span class="retro-title flex items-center gap-2 text-xs sm:text-sm">
        <span class="radar-ping-dot"></span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex items-center" set:html={ICONS.radar}></span> COMPLAINT_RADAR_SCANNER.SYS</span>
      </span>
      <div class="retro-controls">
        <span class="retro-ctrl-btn">_</span>
        <span class="retro-ctrl-btn">□</span>
      </div>
    </div>

    <div class="p-5 sm:p-7 bg-white">
      <form id="trackForm" class="flex flex-col sm:flex-row gap-3 items-stretch">
        <div class="flex-1 relative input-with-prefix">
          <span class="prefix-badge">#</span>
          <input
            type="number"
            id="trackInput"
            placeholder="Enter Ticket ID (e.g. 101, 102, 103, 105)..."
            data-i18n-placeholder="track.inputPlaceholder"
            class="retro-input text-base font-bold pl-12 h-12 w-full"
            min="1"
            required
          />
        </div>
        <button type="submit" class="retro-btn retro-btn-pixel retro-btn-pink h-12 px-6 justify-center flex items-center gap-2 text-sm" data-i18n="track.scanBtn">
          <span class="inline-flex items-center" set:html={ICONS.search}></span>
          <span>SCAN TICKET STATUS</span>
        </button>
      </form>

      <!-- Quick Demo Chips Bar -->
      <div class="quick-chips-section mt-5 pt-4 border-t border-gray-200">
        <div class="text-xs font-bold text-gray-500 mb-2.5 flex items-center gap-1.5" data-i18n="track.quickTicketsLabel">
          <span class="inline-flex items-center" set:html={ICONS.zap}></span>
          <span>Quick Test Tickets:</span>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <button type="button" class="quick-chip chip-facilities" data-id="101">
            <span class="chip-badge">#101</span> Water Filter Leaking <span class="chip-state">In Progress</span>
          </button>
          <button type="button" class="quick-chip chip-mess" data-id="102">
            <span class="chip-badge">#102</span> Canteen Hygiene <span class="chip-state">Review</span>
          </button>
          <button type="button" class="quick-chip chip-transport" data-id="103">
            <span class="chip-badge">#103</span> Route 4 Bus Delay <span class="chip-state">Resolved</span>
          </button>
          <button type="button" class="quick-chip chip-safety" data-id="105">
            <span class="chip-badge">#105</span> North Gate Streetlight <span class="chip-state">Resolved</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Radar Terminal State -->
  <div id="trackLoading" class="hidden max-w-xl mx-auto my-12 text-center">
    <div class="retro-window p-6 bg-white inline-block shadow-neo">
      <div class="radar-spinner mb-3">
        <div class="radar-sweep"></div>
      </div>
      <p class="font-mono text-xs sm:text-sm font-extrabold text-black" data-i18n="track.scanningText">
        RADAR SCANNING UNIVERSITY OF BARISHAL DATABASE...
      </p>
      <span class="text-[11px] font-mono text-gray-500 mt-1 block">Inspecting Drizzle ORM records & technician logs</span>
    </div>
  </div>

  <!-- Detailed Ticket Dossier Result Container -->
  <div id="trackResultContainer" class="hidden max-w-3xl mx-auto mb-12">
    <div class="retro-window result-window">
      <div class="retro-titlebar cyan flex items-center justify-between" id="resultTitlebar">
        <span class="retro-title text-xs sm:text-sm inline-flex items-center gap-1.5" id="resultTitle">
          <span class="inline-flex items-center" set:html={ICONS.fileText}></span> TICKET DOSSIER
        </span>
        <div class="retro-controls">
          <span class="retro-ctrl-btn">_</span>
          <span class="retro-ctrl-btn">□</span>
        </div>
      </div>
      <div class="p-5 sm:p-7 bg-white" id="resultBody">
        <!-- Injected via client script -->
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Radar Ping Animation */
  .radar-ping-dot {
    width: 10px;
    height: 10px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: radarPulse 1.8s infinite;
  }
  @keyframes radarPulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 7px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  /* Input Prefix Badge */
  .input-with-prefix {
    position: relative;
  }
  .prefix-badge {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: var(--pastel-yellow);
    border: 1.5px solid var(--border-black);
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    box-shadow: 1px 1px 0 var(--border-black);
    pointer-events: none;
  }

  /* Quick Demo Chips */
  .quick-chip {
    background: #ffffff;
    border: 2px solid var(--border-black);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.75rem;
    cursor: pointer;
    box-shadow: var(--shadow-neo-sm);
    transition: all 0.12s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .quick-chip:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-neo);
  }
  .quick-chip:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--border-black);
  }
  .chip-badge {
    background: #f3f4f6;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: monospace;
    font-weight: 800;
  }
  .chip-state {
    font-size: 0.7rem;
    opacity: 0.85;
  }
  .chip-facilities:hover { background: var(--pastel-cyan); }
  .chip-mess:hover { background: var(--pastel-yellow); }
  .chip-transport:hover { background: var(--pastel-mint); }
  .chip-safety:hover { background: var(--pastel-rose); }

  /* Radar Spinner Loading State */
  .radar-spinner {
    width: 60px;
    height: 60px;
    border: 3px solid var(--border-black);
    border-radius: 50%;
    margin: 0 auto;
    position: relative;
    background: radial-gradient(circle, #ecfdf5 20%, #d1fae5 80%);
    overflow: hidden;
  }
  .radar-sweep {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.8), transparent);
    transform-origin: 0 0;
    animation: radarRotate 1.4s linear infinite;
  }
  @keyframes radarRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Result Container Shadows */
  .result-window {
    box-shadow: var(--shadow-neo-lg);
  }
</style>

<script>
  import { ICONS } from '../lib/icons.js';
  import { getCategoryMeta } from '../lib/categories.js';
  import { formatDate } from '../lib/date.js';
  import { toBengaliDigits, formatBengaliDate, translateStatus, translatePriority } from '../lib/i18n.js';

  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
  const trackForm = document.getElementById('trackForm');
  const trackInput = document.getElementById('trackInput') as HTMLInputElement | null;
  const resultContainer = document.getElementById('trackResultContainer');
  const resultBody = document.getElementById('resultBody');
  const resultTitle = document.getElementById('resultTitle');
  const loading = document.getElementById('trackLoading');

  async function searchTicket(id: number) {
    if (!resultContainer || !resultBody || !loading) return;

    loading.classList.remove('hidden');
    resultContainer.classList.add('hidden');

    let ticket: any = null;
    let timelines: any[] = [];

    try {
      const res = await fetch(`${API_URL}/complaints/${id}`, { credentials: 'include' });
      if (res.ok) {
        const json = await res.json();
        ticket = json.data;
      }
    } catch {
      // Fallback below
    }

    // Dynamic on-demand sample data fallback if offline
    if (!ticket) {
      try {
        const sample = await import('../services/sampleData.js');
        ticket = sample.SAMPLE_COMPLAINTS.find((c) => c.id === id);
        timelines = sample.SAMPLE_TIMELINES[id] || [];
      } catch {
        ticket = null;
      }
    }

    loading.classList.add('hidden');

    const lang = (localStorage.getItem('campusfix_lang') as 'en' | 'bn') || 'en';
    const isBn = lang === 'bn';

    if (!ticket) {
      resultContainer.classList.remove('hidden');
      if (resultTitle) resultTitle.textContent = isBn ? `টিকিট #${toBengaliDigits(id)} পাওয়া যায়নি` : `TICKET #${id} NOT FOUND`;
      resultBody.innerHTML = `
        <div class="text-center py-10">
          <div class="w-12 h-12 rounded-full border-2 border-black bg-yellow-100 flex items-center justify-center mx-auto mb-3 text-black">
            ${ICONS.search}
          </div>
          <h4 class="font-extrabold text-lg mb-1.5 text-black">
            ${isBn ? `আইডি #${toBengaliDigits(id)} এর কোনো অভিযোগ পাওয়া যায়নি` : `No complaint ticket found with ID #${id}`}
          </h4>
          <p class="text-xs sm:text-sm text-gray-600 mb-5 max-w-md mx-auto leading-relaxed">
            ${isBn ? 'টিকিট নম্বরটি সঠিক কিনা পরীক্ষা করুন অথবা এটি কোনো গোপনীয় হুইসেলব্লোয়ার রিপোর্ট কিনা নিশ্চিত হোন।' : 'Please verify the ticket ID number or check if this report was sealed under confidential whistleblower status.'}
          </p>
          <div class="flex items-center justify-center gap-2 flex-wrap">
            <a href="/" class="retro-btn retro-btn-pixel retro-btn-yellow text-xs inline-flex items-center gap-1.5">
              ${ICONS.bullhorn} <span>${isBn ? 'উন্মুক্ত ফিড ব্রাউজ করুন' : 'Browse Public Feed'}</span>
            </a>
            <button type="button" class="retro-btn retro-btn-sm inline-flex items-center gap-1.5" onclick="document.getElementById('trackInput')?.focus()">
              ${ICONS.radar} <span>${isBn ? 'পুনরায় খুঁজুন' : 'Try Another ID'}</span>
            </button>
          </div>
        </div>
      `;
      return;
    }

    const isResolved = ticket.status === 'resolved';
    const isProgress = ticket.status === 'in_progress';
    const isReview = ticket.status === 'under_review';

    const catMeta = getCategoryMeta(ticket.category);
    const catLabel = isBn ? (catMeta.labelBn || catMeta.label) : catMeta.label;
    const priLabel = translatePriority(ticket.priority, lang);
    const statusLabel = translateStatus(ticket.status, lang);
    const dateFormatted = isBn ? formatBengaliDate(ticket.createdAt) : formatDate(ticket.createdAt);
    const ticketIdStr = isBn ? toBengaliDigits(ticket.id) : String(ticket.id);
    const upvotesStr = isBn ? toBengaliDigits(ticket.upvotesCount || 0) : String(ticket.upvotesCount || 0);

    resultContainer.classList.remove('hidden');
    if (resultTitle) {
      resultTitle.textContent = isBn
        ? `টিকিট #${ticketIdStr} • ${catLabel}`
        : `TICKET #${ticket.id} • ${ticket.category.toUpperCase()}`;
    }

    resultBody.innerHTML = `
      <div class="flex flex-col gap-6">
        <!-- Top Metadata & Status Row -->
        <div class="flex justify-between items-start sm:items-center gap-4 flex-col sm:flex-row pb-5 border-b-2 border-gray-100">
          <div>
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="category-pill-sm font-bold text-xs" style="background: ${catMeta.color}; border: 1.5px solid var(--border-black); padding: 0.2rem 0.55rem; border-radius: 6px;">
                ${catMeta.icon} ${catLabel}
              </span>
              <span class="retro-badge text-xs font-bold priority-badge priority-${ticket.priority} inline-flex items-center gap-1">
                ${ICONS.lightning} ${priLabel.toUpperCase()}
              </span>
              ${ticket.visibility === 'private' ? '<span class="retro-badge inline-flex items-center gap-1" style="background: var(--pastel-rose)">' + ICONS.lock + ' ' + (isBn ? 'গোপনীয় ভল্ট' : 'CONFIDENTIAL') + '</span>' : ''}
            </div>
            <h2 class="font-extrabold text-xl sm:text-2xl text-black tracking-tight">${ticket.title}</h2>
          </div>
          <div class="status-stamp stamp-${ticket.status}">
            ${statusLabel}
          </div>
        </div>

        <!-- Complainant Author Profile Card -->
        <div class="p-3.5 border-2 border-black rounded-xl bg-yellow-50/70 shadow-sm flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full border-2 border-black overflow-hidden bg-yellow-200 flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
              ${ticket.isAnonymous
                ? '<span class="inline-flex items-center">' + ICONS.userMask + '</span>'
                : (ticket.author?.image
                    ? `<img src="${ticket.author.image}" alt="${ticket.author.name || 'Author'}" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" /><span class="hidden font-bold">${(ticket.author?.name || 'S').charAt(0).toUpperCase()}</span>`
                    : `<span>${(ticket.author?.name || 'S').charAt(0).toUpperCase()}</span>`
                  )
              }
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-extrabold text-xs sm:text-sm text-black">
                  ${ticket.isAnonymous ? (isBn ? 'বেনামি শিক্ষার্থী' : 'Anonymous Student') : (ticket.author?.name || (isBn ? 'শিক্ষার্থী' : 'Student'))}
                </span>
                <span class="retro-badge text-[10px] py-0.5 px-1.5" style="background: ${ticket.isAnonymous ? 'var(--pastel-blue)' : 'var(--pastel-yellow)'}">
                  ${ticket.isAnonymous ? (isBn ? 'হুইসেলব্লোয়ার' : 'WHISTLEBLOWER') : (isBn ? 'অভিযোগকারী' : 'COMPLAINANT')}
                </span>
              </div>
              <span class="text-[11px] text-gray-600 block mt-0.5 font-medium">
                ${ticket.isAnonymous
                  ? (isBn ? 'বিশ্ববিদ্যালয় গোপনীয়তা নীতির অধীনে পরিচয় সুরক্ষিত' : 'Whistleblower identity protected by University Privacy Gate')
                  : (ticket.author?.department || (isBn ? 'বরিশাল বিশ্ববিদ্যালয়' : 'University of Barishal'))}
              </span>
            </div>
          </div>
          <span class="text-[11px] font-mono text-gray-500">
            ${isBn ? 'দাখিলকৃত: ' : 'Filed: '} ${dateFormatted}
          </span>
        </div>

        <!-- 4-Stage Visual Progress Lifecycle Stepper -->
        <div class="p-4 sm:p-5 border-2 border-black rounded-xl bg-orange-50/50 shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-xs font-bold text-gray-700 tracking-wider">
              ${isBn ? 'সমাধান পর্যায় ও অগ্রগতি লাইফসাইকেল' : 'RESOLUTION PROGRESS LIFECYCLE'}
            </span>
            <span class="font-mono text-[11px] text-gray-500">
              ${isBn ? 'দাখিলকৃত:' : 'Filed on:'} ${dateFormatted}
            </span>
          </div>

          <div class="grid grid-cols-4 gap-2 text-center text-xs">
            <div class="p-2 sm:p-2.5 border-2 border-black rounded-lg bg-emerald-200 font-bold shadow-sm flex flex-col items-center justify-center">
              <div class="w-4 h-4 mb-1">${ICONS.check}</div>
              <span>${isBn ? '১. দাখিল' : '1. Submitted'}</span>
            </div>
            <div class="p-2 sm:p-2.5 border-2 border-black rounded-lg ${isReview || isProgress || isResolved ? 'bg-emerald-200 font-bold shadow-sm' : 'bg-gray-100 text-gray-400 opacity-60'} flex flex-col items-center justify-center">
              <div class="w-4 h-4 mb-1">${isReview || isProgress || isResolved ? ICONS.check : ICONS.clock}</div>
              <span>${isBn ? '২. যাচাই' : '2. Triage'}</span>
            </div>
            <div class="p-2 sm:p-2.5 border-2 border-black rounded-lg ${isProgress || isResolved ? 'bg-emerald-200 font-bold shadow-sm' : 'bg-gray-100 text-gray-400 opacity-60'} flex flex-col items-center justify-center">
              <div class="w-4 h-4 mb-1">${isProgress ? ICONS.tool : isResolved ? ICONS.check : ICONS.tool}</div>
              <span>${isBn ? '৩. মেরামত' : '3. Repair'}</span>
            </div>
            <div class="p-2 sm:p-2.5 border-2 border-black rounded-lg ${isResolved ? 'bg-emerald-300 font-extrabold text-emerald-950 shadow-sm' : 'bg-gray-100 text-gray-400 opacity-60'} flex flex-col items-center justify-center">
              <div class="w-4 h-4 mb-1">${isResolved ? ICONS.shieldCheck : ICONS.flag}</div>
              <span>${isBn ? '৪. সমাধান' : '4. Resolved'}</span>
            </div>
          </div>
        </div>

        <!-- Issue Description Box -->
        <div class="p-4 sm:p-5 border-2 border-black rounded-xl bg-white shadow-neo-sm">
          <div class="font-bold text-xs text-gray-500 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <span class="inline-flex items-center">${ICONS.fileText}</span>
            <span>${isBn ? 'অভিযোগের বিবরণ ও ভৌগোলিক অবস্থান' : 'COMPLAINT DETAILS & LOCATION'}</span>
          </div>
          <p class="text-xs sm:text-sm text-gray-800 leading-relaxed font-medium">
            ${ticket.description}
          </p>
        </div>

        <!-- Official Resolution Note Certificate (if available) -->
        ${
          ticket.resolutionNote
            ? `
          <div class="p-5 border-2 border-emerald-600 rounded-xl bg-emerald-50 text-emerald-950 shadow-neo-sm">
            <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
              <span class="font-mono text-xs font-extrabold flex items-center gap-1.5 text-emerald-800 uppercase tracking-wider">
                <span class="inline-flex items-center">${ICONS.shieldCheck}</span>
                <span>${isBn ? 'যাচাইকৃত প্রক্টরিয়াল সমাধান সনদ:' : 'OFFICIAL VERIFIED RESOLUTION CERTIFICATE:'}</span>
              </span>
              ${ticket.resolvedAt ? '<span class="retro-badge text-[10px]" style="background: var(--pastel-mint)">' + (isBn ? formatBengaliDate(ticket.resolvedAt) : formatDate(ticket.resolvedAt)) + '</span>' : ''}
            </div>
            <p class="text-xs sm:text-sm leading-relaxed font-medium mb-3">
              ${ticket.resolutionNote}
            </p>
            <div class="text-[11px] font-mono text-emerald-700 flex items-center gap-2">
              <span>Verified By: University Maintenance & Proctorial Authority</span>
            </div>
          </div>
        `
            : ''
        }

        <!-- Technician & Dispatch Timeline Logs -->
        ${
          timelines.length > 0
            ? `
          <div class="pt-2">
            <h4 class="font-mono text-xs font-extrabold text-gray-700 uppercase tracking-wider mb-3 flex items-center gap-2">
              <span class="inline-flex items-center">${ICONS.clock}</span>
              <span>${isBn ? 'মেরামত কার্যক্রম ও টেকনিশিয়ান লগ' : 'DISPATCH TIMELINE & TECHNICIAN LOGS'}</span>
            </h4>
            <div class="flex flex-col gap-2.5">
              ${timelines
                .map(
                  (t) => `
                <div class="bg-white border-2 border-black rounded-lg p-3.5 text-xs flex flex-col gap-1.5 shadow-sm transition-all hover:bg-yellow-50/50">
                  <div class="flex justify-between items-center font-bold text-gray-900 flex-wrap gap-2">
                    <span class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-full border border-black overflow-hidden bg-yellow-200 flex items-center justify-center text-[10px] flex-shrink-0">
                        ${t.authorImage
                          ? `<img src="${t.authorImage}" alt="${t.author}" class="w-full h-full object-cover" />`
                          : (t.author ? t.author.charAt(0).toUpperCase() : 'A')
                        }
                      </div>
                      <span>${t.author}</span>
                      <small class="text-gray-500 font-mono">(${t.role})</small>
                    </span>
                    <span class="text-gray-500 font-mono text-[11px] bg-gray-100 px-2 py-0.5 rounded border border-gray-300">${t.time}</span>
                  </div>
                  <p class="text-gray-700 leading-relaxed font-medium pl-8 border-l-2 border-gray-200">${t.content}</p>
                </div>
              `,
                )
                .join('')}
            </div>
          </div>
        `
            : ''
        }

        <!-- Action Footer -->
        <div class="pt-4 border-t border-gray-200 flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" class="retro-btn retro-btn-sm card-upvote-btn inline-flex items-center gap-1.5" data-id="${ticket.id}">
              <span class="inline-flex items-center">${ICONS.thumbsUp}</span>
              <span>${isBn ? '+১ আমিও ভুক্তভোগী' : '+1 Me Too'}</span>
              <span class="font-mono font-bold">(${upvotesStr})</span>
            </button>
            <button type="button" class="retro-btn retro-btn-sm inline-flex items-center gap-1.5" id="shareTrackLinkBtn">
              <span class="inline-flex items-center">${ICONS.copy}</span>
              <span>${isBn ? 'লিংক কপি করুন' : 'Share Ticket'}</span>
            </button>
          </div>
          <button type="button" class="retro-btn retro-btn-sm retro-btn-pixel retro-btn-pink open-create-modal-trigger inline-flex items-center gap-1.5">
            <span class="inline-flex items-center">${ICONS.plus}</span>
            <span>${isBn ? '+ নতুন অভিযোগ দাখিল' : '+ File New Issue'}</span>
          </button>
        </div>
      </div>
    `;

    // Share Ticket Link Button
    document.getElementById('shareTrackLinkBtn')?.addEventListener('click', () => {
      const shareUrl = `${window.location.origin}/track?id=${ticket.id}`;
      navigator.clipboard.writeText(shareUrl);
      const toast = document.getElementById('toast');
      if (toast) {
        toast.textContent = isBn ? 'টিকিট লিংক কপি করা হয়েছে' : 'Ticket link copied to clipboard';
        toast.className = 'retro-toast show';
        setTimeout(() => (toast.className = 'retro-toast'), 2500);
      }
    });
  }

  trackForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (trackInput && trackInput.value) {
      searchTicket(parseInt(trackInput.value, 10));
    }
  });

  document.querySelectorAll('.quick-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const id = chip.getAttribute('data-id');
      if (id && trackInput) {
        trackInput.value = id;
        searchTicket(parseInt(id, 10));
      }
    });
  });

  // Re-run search if language toggled
  window.addEventListener('campusfix:langchange', () => {
    if (trackInput && trackInput.value) {
      searchTicket(parseInt(trackInput.value, 10));
    }
  });

  // Check URL params
  const urlParams = new URLSearchParams(window.location.search);
  const ticketParam = urlParams.get('id');
  if (ticketParam) {
    if (trackInput) trackInput.value = ticketParam;
    searchTicket(parseInt(ticketParam, 10));
  }
</script>
